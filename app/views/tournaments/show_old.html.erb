<div class="space-y-4">
  <div class="gw-window gw-frame">
    <%= render "application/gw_tabs", tabs: [["Tournaments", tournaments_path], [@tournament.title, nil]] %>
    <div class="gw-window-header">
      <h1 class="gw-title text-base m-0"><%= @tournament.title %></h1>
      <% if @tournament.date.present? %>
        <span class="text-muted text-sm"><%= @tournament.date %></span>
      <% end %>
      <% if @tournament.guild_number.present? %>
        <span class="text-muted text-sm">Guild number: <%= @tournament.guild_number %></span>
      <% end %>
    </div>

    <div class="p-4 space-y-6">
      <% if @tournament.tournament_results.swiss_rounds_results.any? %>
        <section>
          <h2 class="font-display text-gold-300 text-base mb-2">Swiss rounds results</h2>
          <div class="overflow-x-auto">
            <table class="gw-table">
              <thead>
                <tr>
                  <th scope="col">Position</th>
                  <th scope="col">Guild name</th>
                  <th scope="col">Guild tag</th>
                  <th scope="col">Region</th>
                </tr>
              </thead>
              <tbody>
                <% @tournament.tournament_results.includes(:guild).swiss_rounds_results.order(position: :asc).each do |tournament_result| %>
                  <tr>
                    <td><%= tournament_result.position %></td>
                    <td><%= link_to tournament_result.guild.name, guild_path(tournament_result.guild), class: "hover:text-gold-400" %></td>
                    <td><%= tournament_result.guild.tag %></td>
                    <td><%= tournament_result.guild.region %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <% if @tournament.tournament_results.final_standings.any? %>
        <section>
          <h2 class="font-display text-gold-300 text-base mb-2">Final standings</h2>
          <div class="overflow-x-auto">
            <table class="gw-table">
              <thead>
                <tr>
                  <th scope="col">Position</th>
                  <th scope="col">Trim</th>
                  <th scope="col">Guild name</th>
                  <th scope="col">Guild tag</th>
                  <th scope="col">Region</th>
                </tr>
              </thead>
              <tbody>
                <% @tournament.tournament_results.includes(:guild).final_standings.order(position: :asc).each do |tournament_result| %>
                  <tr>
                    <td><%= tournament_result.position %></td>
                    <td><%= tournament_result.trim_text %></td>
                    <td><%= link_to tournament_result.guild.name, guild_path(tournament_result.guild), class: "hover:text-gold-400" %></td>
                    <td><%= tournament_result.guild.tag %></td>
                    <td><%= tournament_result.guild.region %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <% if @tournament.map_rotation.present? %>
        <p class="text-muted text-sm m-0">Map rotation: <%= @tournament.map_rotation %></p>
      <% end %>

      <% if @tournament.matches.any? %>
        <section>
          <h2 class="font-display text-gold-300 text-base mb-2">Matches</h2>
          <ul class="list-none m-0 p-0 border-t border-[#2b2010]">
            <% @tournament.matches.order(round: :desc).order(number_on_round: :desc).each do |match| %>
              <li class="border-b border-seam py-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="font-display text-gold-300">
                  <%= link_to match.teams.first.guild.name_with_tag, match_path(match), class: "hover:text-gold-400" %>
                  <span class="text-muted px-1 text-xs">VS</span>
                  <%= link_to match.teams.second.guild.name_with_tag, match_path(match), class: "hover:text-gold-400" %>
                </span>
                <span class="text-xs text-muted">
                  <%= link_to match.round_text, match_path(match) %> · <%= link_to 'Guild details', guild_path(match.teams.first.guild), class: 'hover:text-gold-400' %> · <%= link_to 'Guild details', guild_path(match.teams.second.guild), class: 'hover:text-gold-400' %>
                </span>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  </div>

  <div class="gw-window gw-frame">
    <div class="gw-window-header">
      <h2 class="font-display text-gold-300 text-base m-0">Comments <small>(<%= @tournament.comments.count %>)</small></h2>
    </div>
    <div class="p-4 space-y-4">
      <% if current_player %>
        <% if @tournament.comments.any? %>
          <ul class="list-none m-0 p-0 space-y-3">
            <% @tournament.comments.each do |comment| %>
              <li>
                <%= link_to "#{comment.player.name} (#{comment.player.verification_status})", player_path(comment.player), class: 'text-gold-400' %>
                <div class="text-xs text-muted"><%= time_ago_in_words(comment.created_at) %></div>
                <p class="m-0 mt-1"><%= comment.body %></p>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-muted text-sm">No comments yet.</p>
        <% end %>
        <%= form_with model: @comment, url: comments_path, class: 'm-0 space-y-3' do |form| %>
          <%= form.hidden_field :commentable_type, value: 'Tournament' %>
          <%= form.hidden_field :commentable_id, value: @tournament.id %>
          <%= form.text_area :body, rows: 5, placeholder: 'Your Comment', class: 'gw-textarea' %>
          <%= form.submit 'Submit', class: 'gw-btn' %>
        <% end %>
      <% else %>
        <p>You need to be logged in to see or post comments.</p>
        <%= form_tag(omniauth_authorize_path(:player, :discord), method: 'post', data: { turbo: false }) do %>
          <button type="submit" class="gw-btn">Login with Discord</button>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
