<div class="space-y-4">
  <div class="gw-window gw-frame">
    <%= render "application/gw_tabs", tabs: [["Tournaments", tournaments_path]] %>
    <div class="gw-window-header">
      <h1 class="gw-title text-base m-0">Tournaments</h1>
      <span class="gw-count text-sm"><%= @pagy.count %> tournaments</span>
    </div>

    <details class="border-b border-hairline" <%= 'open' if params[:date_from].present? || params[:date_to].present? || params[:tournament_type].present? || params[:flux_month].present? %>>
      <summary class="gw-window-header cursor-pointer select-none list-none">
        <span class="gw-title text-xs">Filters</span>
        <% active_filters = params[:date_from].present? || params[:date_to].present? || params[:tournament_type].present? || params[:flux_month].present? %>
        <span class="text-muted text-xs"><%= active_filters ? "· active" : "· none" %></span>
      </summary>
      <div class="p-4">
        <%= render "tournaments/filters" %>
      </div>
    </details>

    <div class="p-4 space-y-4">
      <% if @tournaments.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @tournaments.each do |tournament| %>
            <div class="gw-parchment border border-gold-600/40 rounded-md p-4 hover:border-gold-500 transition-colors">
              <h2 class="font-display text-base m-0">
                <%= link_to tournament.title, tournament_path(tournament), class: "hover:text-gold-500" %>
              </h2>
              <ul class="list-none m-0 mt-2 p-0 text-sm space-y-1">
                <% if tournament.date.present? %>
                  <li><%= tournament.date %></li>
                <% end %>
                <% if tournament.guild_number.present? %>
                  <li>Guild number: <%= tournament.guild_number %></li>
                <% end %>
                <% if tournament.winner_guild.present? %>
                  <li>Winner: <%= link_to tournament.winner_guild.name_with_tag, guild_path(tournament.winner_guild), class: "hover:text-gold-500" %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
        <div class="flex justify-center">
          <div class="gw-pagy"><%== @pagy.series_nav(:bootstrap) %></div>
        </div>
      <% else %>
        <p class="gw-empty">No tournaments found for these filters.</p>
      <% end %>
    </div>
  </div>
</div>
