<%= form_with url: tournaments_path, method: :get, class: "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 items-end" do |form| %>
  <div>
    <%= form.label :date_from, "From", class: "block text-sm text-muted mb-1" %>
    <%= form.date_field :date_from, value: params[:date_from], class: "gw-input" %>
  </div>
  <div>
    <%= form.label :date_to, "To", class: "block text-sm text-muted mb-1" %>
    <%= form.date_field :date_to, value: params[:date_to], class: "gw-input" %>
  </div>
  <div>
    <%= form.label :tournament_type, "Tournament Type", class: "block text-sm text-muted mb-1" %>
    <%= form.select :tournament_type, options_for_select([['All', ''], ['mAT', 'mat'], ['AT', 'at']], params[:tournament_type]), {}, class: "gw-select" %>
  </div>
  <div>
    <%= form.label :flux_year, "Year", class: "block text-sm text-muted mb-1" %>
    <%= form.select :flux_year,
      options_for_select(
        (Match.oldest_year..Date.current.year).to_a.reverse.map { |year| [year, year] },
        params[:flux_year] || Date.current.year
      ),
      {},
      class: "gw-select" %>
  </div>
  <div>
    <%= form.label :flux_month, "Month/Flux", class: "block text-sm text-muted mb-1" %>
    <%= form.select :flux_month,
      options_for_select(
        [['January - Odran\'s Razor', '1'],
         ['February - Amateur Hour', '2'],
         ['March - Hidden Talent', '3'],
         ['April - There Can Be Only One', '4'],
         ['May - Meek Shall Inherit', '5'],
         ['June - Jack of All Trades', '6'],
         ['July - Chain Combo', '7'],
         ['August - Xinrae\'s Revenge', '8'],
         ['September - Like a Boss (and The Boss)', '9'],
         ['October - Minion Apocalypse', '10'],
         ['November - All In', '11'],
         ['December - Parting Gift (and Gift of Battle)', '12']],
        params[:flux_month]
      ),
      { prompt: 'Select Month' },
      class: "gw-select" %>
  </div>
  <div>
    <%= form.button "Filter", class: "gw-btn" %>
  </div>
<% end %>
