<div class="space-y-4">
  <div class="gw-window gw-frame">
    <%= render "application/gw_tabs", tabs: [["Search", search_path]] %>
    <div class="gw-window-header">
      <h1 class="gw-title text-base m-0">Search</h1>
      <% if @search_query.present? %>
        <span class="text-muted text-sm"><%= @search_query %></span>
      <% end %>
    </div>

    <div class="p-4 space-y-6">
      <%= render "form", search_query: @search_query %>

      <% if @guilds.any? %>
        <section>
          <h2 class="font-display text-gold-300 text-base mb-2">Guilds</h2>
          <ul class="list-none m-0 p-0">
            <% @guilds.each do |guild| %>
              <li>
                <%= link_to guild_path(guild), class: "gw-row" do %>
                  <span class="flex-1 min-w-0 font-display text-gold-300 text-base leading-snug truncate"><%= guild.name_with_tag %></span>
                  <span class="shrink-0 text-sm text-muted">Best position: <%= guild.best_position %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <% if @players.any? %>
        <section>
          <h2 class="font-display text-gold-300 text-base mb-2">Players</h2>
          <ul class="list-none m-0 p-0">
            <% @players.each do |player| %>
              <li>
                <%= link_to player_path(player), class: "gw-row" do %>
                  <span class="flex-1 min-w-0 font-display text-gold-300 text-base leading-snug truncate"><%= display_player_name(player, current_player) %></span>
                  <% if player.guild.present? %>
                    <span class="shrink-0 text-sm text-muted"><%= player.guild.name_with_tag %></span>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <% if @characters.any? %>
        <section>
          <h2 class="font-display text-gold-300 text-base mb-2">Matches with player</h2>
          <ul class="list-none m-0 p-0">
            <% @characters.each do |character| %>
              <% character.team_players.each do |team_player| %>
                <li>
                  <%= link_to match_path(team_player.team.match), class: "gw-row" do %>
                    <span class="flex-1 min-w-0 font-display text-gold-300 text-base leading-snug truncate"><%= team_player.team.match.title %></span>
                    <span class="shrink-0 text-sm text-muted"><%= display_character_name(character, current_player) %></span>
                  <% end %>
                </li>
              <% end %>
            <% end %>
          </ul>
        </section>
      <% end %>

      <% if @guilds.blank? && @players.blank? && @characters.blank? %>
        <p class="gw-empty">No results found.</p>
      <% end %>
    </div>
  </div>
</div>
