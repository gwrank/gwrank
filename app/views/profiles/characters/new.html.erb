<%= render "application/gw_card", title: "Add Character" do %>
  <%= form_with model: @character, url: profile_characters_path do |form| %>
    <div class="space-y-3">
      <%= form.label :igname, 'In-game name', class: 'block text-sm text-parchment' %>
      <%= form.text_field :igname, class: 'gw-input', required: true %>
      <%= form.label :profession_id, 'Profession', class: 'block text-sm text-parchment' %>
      <%= form.select :profession_id, options_from_collection_for_select(@professions, :id, :name, @character.profession_id), { include_blank: true }, class: 'gw-input' %>
    </div>
    <%= form.submit 'Publish', class: 'gw-btn mt-4 w-full' %>
  <% end %>
<% end %>
