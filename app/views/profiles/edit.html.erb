<%= render "devise/shared/gw_card", title: "Edit Profile" do %>
  <%= link_to 'My API token', api_token_path, class: 'gw-btn' %>

  <%= form_with model: @player, url: profile_path do |form| %>
    <div class="space-y-3">
      <h2 class="text-sm font-bold text-gold-300 m-0">In-game characters</h2>
      <%= link_to 'Add new character', new_profile_character_path, class: 'gw-btn gw-btn--ghost' %>
      <%= form.label :igname, 'Main in-game name', class: 'block text-sm text-parchment' %>
      <%= form.text_field :igname, class: 'gw-input' %>
      <% @player.characters.each do |character| %>
        <p class="flex items-center justify-between gap-2 m-0">
          <span><%= character.igname %></span>
          <%= link_to 'Unlink', profile_character_path(character), data: { turbo_method: :delete }, class: 'gw-btn gw-btn--ghost' %>
        </p>
      <% end %>

      <h2 class="text-sm font-bold text-gold-300 m-0">Guild</h2>
      <%= link_to 'Add new guild', new_profile_character_path, class: 'gw-btn gw-btn--ghost' %>
      <%= form.label :guild_id, 'Current guild', class: 'block text-sm text-parchment' %>
      <%= form.select :guild_id, options_from_collection_for_select(@guilds, :id, :name_with_tag, @player.guild_id), { include_blank: true }, class: 'gw-input' %>

      <h2 class="text-sm font-bold text-gold-300 m-0">Professions</h2>
      <% { is_warrior: 'Warrior', is_ranger: 'Ranger', is_monk: 'Monk', is_necromancer: 'Necromancer',
           is_mesmer: 'Mesmer', is_elementalist: 'Elementalist', is_assassin: 'Assassin',
           is_ritualist: 'Ritualist', is_paragon: 'Paragon', is_dervish: 'Dervish' }.each do |attr, label| %>
        <label class="flex items-center gap-2 text-sm text-parchment">
          <%= form.check_box attr %> <%= label %>
        </label>
      <% end %>

      <h2 class="text-sm font-bold text-gold-300 m-0">Streaming</h2>
      <%= form.label :twitch_username, 'Twitch username', class: 'block text-sm text-parchment' %>
      <%= form.text_field :twitch_username, class: 'gw-input' %>
    </div>
    <%= form.button 'Submit', class: 'gw-btn mt-4 w-full' %>
  <% end %>

  <%= button_to 'Delete my account', profile_path, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: 'gw-btn gw-btn--danger w-full' %>
<% end %>
