<tr>
  <td>
    <%= link_to(display_team_player_name(team_player, current_player), player_path(team_player.player)) %>
    <span class="float-right gw-imgs-inline">
      <%= team_player.profession.html_image %>
      <%= team_player.secondary_profession&.html_image %>
      <%= render "application/template_code_popover",
            template_code: team_player.template_code,
            name: display_team_player_name(team_player, current_player),
            primary_profession: team_player.profession,
            secondary_profession: team_player.secondary_profession,
            assignment: nil %>
    </span>
    <br>
    <div class="gw-imgs-inline clear-both"><%= team_player.html_skills.html_safe %></div>
  </td>
</tr>
