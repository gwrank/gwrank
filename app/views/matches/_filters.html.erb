<div class="match-filters mb-50">
  <%= form_with url: matches_path, method: :get, class: "row g-3" do |form| %>
    <div class="col-md-3">
      <%= form.label :opponent, "Search Opponent", class: "form-label" %>
      <%= form.text_field :opponent, value: params[:opponent], placeholder: "Guild or player name", class: "form-control" %>
    </div>
    <div class="col-md-2">
      <%= form.label :date_from, "From", class: "form-label" %>
      <%= form.date_field :date_from, value: params[:date_from], class: "form-control" %>
    </div>
    <div class="col-md-2">
      <%= form.label :date_to, "To", class: "form-label" %>
      <%= form.date_field :date_to, value: params[:date_to], class: "form-control" %>
    </div>
    <div class="col-md-2">
      <%= form.label :tournament_type, "Tournament Type", class: "form-label" %>
      <%= form.select :tournament_type, options_for_select([['All', ''], ['mAT', 'mat'], ['AT', 'at']], params[:tournament_type]), {}, class: "form-select" %>
    </div>
    <div class="col-md-2">
      <%= form.label :tournament_region, "AT Region", class: "form-label" %>
      <%= form.select :tournament_region, options_for_select([['All', ''], ['A', 'a'], ['B', 'b'], ['C', 'c']], params[:tournament_region]), {}, class: "form-select", disabled: params[:tournament_type] != 'at' %>
    </div>
    <div class="col-md-2">
      <%= form.label :map_id, "Map/Guild Hall", class: "form-label" %>
      <%= form.select :map_id, options_for_select([['All Maps', '']] + @unique_maps.map { |map_id, data|
        guild_hall_text = data[:is_guild_hall] ? ' (Guild Hall)' : ''
        ["#{data[:name]}#{guild_hall_text}", map_id]
      }, params[:map_id]), {}, class: "form-select" %>
    </div>
    <div class="col-md-1 d-flex align-items-end">
      <%= form.button "Filter", class: "btn btn-md" %>
    </div>
  <% end %>
</div>

<script>
  // Enable/disable region dropdown based on tournament type selection
  document.addEventListener('DOMContentLoaded', function() {
    const tournamentTypeSelect = document.querySelector('select[name="tournament_type"]');
    const regionSelect = document.querySelector('select[name="tournament_region"]');
    
    if (tournamentTypeSelect && regionSelect) {
      tournamentTypeSelect.addEventListener('change', function() {
        regionSelect.disabled = this.value !== 'at';
        if (this.value !== 'at') {
          regionSelect.value = '';
        }
      });
    }
  });
</script>

