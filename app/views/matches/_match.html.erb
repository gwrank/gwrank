<li class="relative list-none m-0 p-0" data-controller="match-builds" data-match-builds-match-id-value="<%= match.id %>">
  <div class="match-row-inner flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:gap-3">
    <%= link_to match_path(match), class: "min-w-0 flex-1 text-inherit no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500" do %>
      <div class="min-w-0 flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-2">
        <span class="font-display text-gold-300 text-base leading-snug truncate min-w-0">
          <% team_a = match.ordered_teams.first %>
          <% if team_a&.rank.present? %>
            <span class="text-muted">#<%= team_a.rank %></span>
          <% end %>
          <%= team_a&.guild&.name_with_tag || "Unknown Guild" %>
          <% if match.winner_team_id == team_a&.id %>
            <span role="img" aria-label="Winner">🏆</span>
          <% end %>
        </span>

        <span class="text-muted text-xs text-center sm:px-1 sm:shrink-0">VS</span>

        <span class="font-display text-gold-300 text-base leading-snug truncate min-w-0">
          <% team_b = match.ordered_teams.second %>
          <% if team_b&.rank.present? %>
            <span class="text-muted">#<%= team_b.rank %></span>
          <% end %>
          <%= team_b&.guild&.name_with_tag || "Unknown Guild" %>
          <% if match.winner_team_id == team_b&.id %>
            <span role="img" aria-label="Winner">🏆</span>
          <% end %>
        </span>
      </div>

      <span class="flex flex-wrap items-center gap-2 mt-1 text-xs text-muted">
        <span><%= match.round_text %></span>
        <% if match.tournament&.tournament_type.present? %>
          <span class="gw-badge gw-badge--tag"><%= match.tournament.tournament_type.upcase %></span>
        <% end %>
        <span><%= match.played_at&.to_date %></span>
      </span>
    <% end %>

    <button
      type="button"
      class="shrink-0 rounded-full p-0.5"
      data-match-builds-target="toggle"
      data-action="click->match-builds#toggle mouseenter->match-builds#show mouseleave->match-builds#hide focusin->match-builds#show focusout->match-builds#hide keydown->match-builds#onKey"
      aria-expanded="false"
      aria-controls="match-builds-popup-<%= match.id %>"
      aria-label="Show team builds">
      <span class="flex -space-x-1.5" aria-hidden="true">
        <% match.ordered_teams.first&.team_players&.order(:position)&.each do |team_player| %>
          <span class="gw-prof-chip w-6 h-6"><%= team_player.profession.html_image_simple(size: 24) %></span>
        <% end %>
        <span class="w-2"></span>
        <% match.ordered_teams.second&.team_players&.order(:position)&.each do |team_player| %>
          <span class="gw-prof-chip w-6 h-6"><%= team_player.profession.html_image_simple(size: 24) %></span>
        <% end %>
      </span>
    </button>
  </div>

  <div
    id="match-builds-popup-<%= match.id %>"
    class="match-builds-popup absolute left-0 top-full z-40 w-full"
    data-match-builds-target="popup"
    style="display: none;">
    <div class="gw-window gw-frame p-4 grid gap-4 sm:grid-cols-2 max-h-[70vh] overflow-y-auto">
      <% match.ordered_teams.each do |team| %>
        <div>
          <h4 class="font-display text-gold-300 text-sm mb-2"><%= team.guild.name_with_tag %></h4>
          <div class="grid gap-3">
            <% team.team_players.order(:position).each do |team_player| %>
              <div>
                <div class="flex items-center gap-1">
                  <%= team_player.profession.html_image_simple.html_safe %>
                  <%= team_player.secondary_profession.html_image_simple.html_safe if team_player.secondary_profession %>
                  <span class="text-parchment text-sm"><%= display_team_player_name(team_player, current_player) %></span>
                </div>
                <div class="mt-1 gw-imgs-inline"><%= team_player.html_skills_simple.html_safe %></div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</li>
