<div class="space-y-4">
  <div class="gw-window gw-frame">
    <% tabs = [["Tournaments", tournaments_path]] %>
    <% tabs << [@match.tournament.title, tournament_path(@match.tournament)] if @match.tournament %>
    <% tabs << [@match.title, nil] %>
    <%= render "application/gw_tabs", tabs: tabs %>
    <div class="gw-window-header">
      <h1 class="gw-title text-base m-0"><%= @match.title %></h1>
      <% if current_player&.is_moderator? && @match.imported_by.eql?(current_player) %>
        <%= button_to 'Delete match', match_path, method: :delete, data: { turbo_confirm: "Are you sure?" }, form_class: 'ml-auto', class: 'gw-btn gw-btn--danger' %>
      <% end %>
    </div>

    <div class="p-4 space-y-6">
      <% if @match.memorial_match_id.present? %>
        <p class="text-sm text-muted">Imported <%= link_to 'from Memorial', "https://memorial.redeemer.biz/memorial/match/#{@match.memorial_match_id}/", target: '_blank', rel: 'noopener noreferrer', class: 'text-gold-400' %></p>
      <% end %>

      <% cache @match do %>
        <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr] items-center gap-4 rounded border border-gold-600/40 p-4">
          <div class="text-center sm:text-left">
            <h2 class="font-display text-gold-300 text-lg m-0">
              <% if @match.teams.winner.rank.present? %>
                <span class="text-muted">#<%= @match.teams.winner.rank %></span>
              <% end %>
              <%= link_to @match.teams.winner.guild.name_with_tag, match_path(@match), class: "hover:text-gold-400" %>
              <span title="Winner">🏆</span>
            </h2>
            <p class="text-sm m-0 mt-1"><%= link_to 'Guild details', guild_path(@match.teams.winner.guild), class: 'text-muted hover:text-gold-400' %></p>
          </div>
          <div class="text-center font-display text-gold-300">
            <div class="text-xs text-muted"><%= @match.round_text %> · <%= @match.tournament&.date %></div>
            <div class="text-2xl tracking-widest">VS</div>
          </div>
          <div class="text-center sm:text-right">
            <h2 class="font-display text-gold-300 text-lg m-0">
              <% if @match.teams.loser.rank.present? %>
                <span class="text-muted">#<%= @match.teams.loser.rank %></span>
              <% end %>
              <%= link_to @match.teams.loser.guild.name_with_tag, match_path(@match), class: "hover:text-gold-400" %>
            </h2>
            <p class="text-sm m-0 mt-1"><%= link_to 'Guild details', guild_path(@match.teams.loser.guild), class: 'text-muted hover:text-gold-400' %></p>
          </div>
        </div>
      <% end %>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <section>
          <h2 class="font-display text-gold-300 text-sm mb-2"><%= @match.teams.winner.guild.name_with_tag %></h2>
          <div class="overflow-x-auto">
            <table class="gw-table">
              <tbody>
                <% @match.teams.winner.team_players.includes(character: [ :player ], profession: [], secondary_profession: [], team_player_skills: [ :skill ], team_player_stats: []).order(position: :asc).each do |team_player| %>
                  <%= render 'team_player', team_player: team_player %>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
        <section>
          <h2 class="font-display text-gold-300 text-sm mb-2"><%= @match.teams.loser.guild.name_with_tag %></h2>
          <div class="overflow-x-auto">
            <table class="gw-table">
              <tbody>
                <% @match.teams.loser.team_players.includes(character: [ :player ], profession: [], secondary_profession: [], team_player_skills: [ :skill ], team_player_stats: []).order(position: :asc).each do |team_player| %>
                  <%= render 'team_player', team_player: team_player %>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <% if @match.map_name.present? %>
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <div class="flex-1 text-center">
            <h3 class="text-parchment mb-1"><%= @match.map_name %></h3>
            <% if @match.match_type.present? || @match.mat_round.present? %>
              <p class="m-0 text-muted">
              <% if @match.match_type.present? %>
                <%= @match.match_type %>
              <% end %>
              <% if @match.match_type&.include?("MAT") && @match.mat_round.present? %>
                - <%= @match.mat_round %>
              <% end %>
              </p>
            <% end %>
          </div>
          <% if @match.map_id.present? && File.exist?(Rails.root.join("app/assets/images/guildhalls/#{@match.map_id}.jpg")) %>
            <%= image_tag "guildhalls/#{@match.map_id}.jpg", alt: @match.map_name, class: 'rounded-md max-w-[400px] w-full' %>
          <% end %>
        </div>
      <% end %>

      <% if @match.movies.any? %>
        <% @match.movies.each do |movie| %>
          <% if movie.provider.eql?('youtube') %>
            <div class="aspect-video max-w-4xl mx-auto">
              <iframe width="100%" height="100%" src="https://www.youtube-nocookie.com/embed/<%= movie.youtube_embed_id %>" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <h2 class="font-display text-gold-300 text-base">Post a YouTube record</h2>
      <% end %>
      <% if current_player && (current_player.is_moderator? || current_player.eql?(@match.imported_by)) %>
        <%= form_with model: @movie, url: movies_path, class: 'm-0 flex flex-wrap gap-2' do |form| %>
          <%= form.hidden_field :movieable_type, value: 'Match' %>
          <%= form.hidden_field :movieable_id, value: @match.id %>
          <%= form.hidden_field :provider, value: 'youtube' %>
          <%= form.url_field :video_url, placeholder: 'YouTube URL', class: 'gw-input flex-1 min-w-[240px]' %>
          <%= form.submit 'Submit', class: 'gw-btn shrink-0' %>
        <% end %>
      <% else %>
        <p>You need to be logged in to post a YouTube record.</p>
        <%= form_tag(omniauth_authorize_path(:player, :discord), method: 'post', data: { turbo: false }) do %>
          <button type="submit" class="gw-btn">Login with Discord</button>
        <% end %>
      <% end %>

      <% if @match.json.present? %>
        <h2 class="font-display text-gold-300 text-base pt-2">Match Statistics</h2>

        <% cache [@match, "stats"], expires_in: 1.hour do %>
          <% health_data = @match.health_percentage_data %>
          <% guild_lord_data = @match.guild_lord_damage_data %>
          <% if health_data %>
            <% has_health = health_data[:team1] && health_data[:team1][:data]&.any? %>
            <% has_morale = health_data[:morale_data] && (health_data[:morale_data][:team1][:data]&.any? || health_data[:morale_data][:team2][:data]&.any?) %>
            <% has_events = (health_data[:death_events]&.any? || health_data[:resurrection_events]&.any? || health_data[:morale_boosts]&.any? || health_data[:npc_death_events]&.any?) %>
            <% has_guild_lords = guild_lord_data && guild_lord_data[:guild_lords]&.any? %>
            <% initial_mode = has_health ? 'health' : (has_events ? 'timeline' : 'health') %>

            <% if has_health || has_events %>
              <div class="gw-window p-4 mb-4"
                   data-controller="health-chart" 
                   data-health-chart-data-value="<%= health_data.to_json %>"
                   data-health-chart-guild-lord-data-value="<%= (guild_lord_data || {}).to_json %>"
                   data-health-chart-initial-mode-value="<%= initial_mode %>"
                   data-health-chart-shrine-icon-value="<%= image_path('commons/shrine.jpg') %>"
                   data-health-chart-ressig-icon-value="<%= image_path('commons/ressig.jpg') %>"
                   data-health-chart-morale-icon-value="<%= image_path('commons/Morale_Boost.jpg') %>">
                <div class="flex flex-wrap justify-between items-center gap-2 mb-2">
                  <p class="text-muted m-0 text-xs">
                  💡 Use mouse wheel to zoom • Click &amp; drag to pan
                  </p>
                  <div class="flex flex-wrap gap-2">
                    <button
                       data-action="click->health-chart#setModeHealth"
                       data-health-chart-target="healthButton"
                       class="gw-btn gw-btn--sm <%= initial_mode == 'health' ? '' : 'gw-btn--ghost' %>">
                      Health
                    </button>
                    <button
                       data-action="click->health-chart#setModeMorale"
                       data-health-chart-target="moraleButton"
                       class="gw-btn gw-btn--sm <%= initial_mode == 'morale' ? '' : 'gw-btn--ghost' %>">
                      Morale
                    </button>
                    <button
                       data-action="click->health-chart#setModeTimeline"
                       data-health-chart-target="timelineButton"
                       class="gw-btn gw-btn--sm <%= initial_mode == 'timeline' ? '' : 'gw-btn--ghost' %>">
                      Timeline
                    </button>
                    <button
                       data-action="click->health-chart#setModeGuildLord"
                       data-health-chart-target="guildLordButton"
                       class="gw-btn gw-btn--sm gw-btn--ghost">
                      Guild Lord Damage
                    </button>
                    <button
                       data-action="click->health-chart#resetZoom"
                       class="gw-btn gw-btn--sm gw-btn--ghost">
                      Reset Zoom
                    </button>
                  </div>
                </div>
                <canvas style="max-height: 450px; height: 450px;"></canvas>
              </div>
            <% end %>
          <% end %>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <section class="gw-window">
              <div class="gw-window-header">
                <h3 class="font-display text-gold-300 text-sm m-0">
                  <%= @match.teams.first.guild.name_with_tag %>
                  <% winning_party = @match.json.dig('winning_party_id') %>
                  <% if winning_party == 1 %>
                    <span title="Winner">🏆</span>
                  <% end %>
                </h3>
              </div>
              <div class="p-3">
                <%= render 'team_stats', team: @match.teams.first, team_stats: @match.team_stats(1), team_index: 1, match: @match %>
              </div>
            </section>
            <section class="gw-window">
              <div class="gw-window-header">
                <h3 class="font-display text-gold-300 text-sm m-0">
                  <% if winning_party == 2 %>
                    <span title="Winner">🏆</span>
                  <% end %>
                  <%= @match.teams.second.guild.name_with_tag %>
                </h3>
              </div>
              <div class="p-3">
                <%= render 'team_stats', team: @match.teams.second, team_stats: @match.team_stats(2), team_index: 2, match: @match %>
              </div>
            </section>
          </div>
        <% end %>
      <% end %>

      <h2 class="font-display text-gold-300 text-base">Comments <small>(<%= @match.comments.count %>)</small></h2>
      <% if @match.comments.any? %>
        <ul class="list-none m-0 p-0 space-y-3">
          <% @match.comments.each do |comment| %>
            <li class="flex gap-3">
              <div>
                <%= link_to "#{comment.player.name} (#{comment.player.verification_status})", player_path(comment.player), class: 'text-gold-400' %>
                <div class="text-xs text-muted"><%= time_ago_in_words(comment.created_at) %></div>
                <p class="m-0 mt-1"><%= comment.body %></p>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
      <h2 class="font-display text-gold-300 text-base">Leave a Comment</h2>
      <% if current_player %>
        <%= form_with model: @comment, url: comments_path, class: 'm-0 space-y-3' do |form| %>
          <%= form.hidden_field :commentable_type, value: 'Match' %>
          <%= form.hidden_field :commentable_id, value: @match.id %>
          <%= form.text_area :body, rows: 5, placeholder: 'Your Comment', class: 'gw-textarea' %>
          <%= form.submit 'Submit', class: 'gw-btn' %>
        <% end %>
      <% else %>
        <p>You need to be logged in to post comments.</p>
        <%= form_tag(omniauth_authorize_path(:player, :discord), method: 'post', data: { turbo: false }) do %>
          <button type="submit" class="gw-btn">Login with Discord</button>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
