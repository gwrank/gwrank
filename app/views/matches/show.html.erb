<div class="content-wrap">
  <div class="mpl-navbar-mobile-overlay"></div>
  <div>
    <section class="mpl-banner mpl-banner-top mpl-banner-parallax mpl-banner-small">
      <div class="mpl-image" data-speed="0.8">
        <%= image_tag 'background.jpg', class: 'jarallax-img' %>
      </div>
      <div class="mpl-banner-content mpl-box-sm">
        <div class="container">
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/">Home</a></li>
              <li class="breadcrumb-item"><%= link_to 'Tournaments', tournaments_path %></li>
              <li class="breadcrumb-item"><%= link_to @match.tournament.title, tournament_path(@match.tournament) %></li>
              <li class="breadcrumb-item active" aria-current="page"><%= @match.title %></li>
            </ol>
          </nav>
          <h1 class="lg:display-1 mb-0"><%= @match.title %></h1>
        </div>
      </div>
    </section>
    <div class="mpl-box-md">
      <div class="container">
        <div class="row hgap-lg vgap-lg">
          <div class="col-lg single-match">
            <% if current_player&.is_moderator? && @match.imported_by.eql?(current_player) %>
              <%= button_to 'Delete match', match_path, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: 'btn btn-md btn-danger' %>
            <% end %>
            <% if @match.memorial_match_id.present? %>
              <h4>Imported <%= link_to 'from Memorial', "https://memorial.redeemer.biz/memorial/match/#{@match.memorial_match_id}/", target: '_blank' %></h4>
            <% end %>
            <div class="cyberpress-match">
              <div class="cyberpress-match-participants">
                <div class="cyberpress-match-participant accordion" id="accordion" role="tablist" aria-multiselectable="true">
                  <table class="table table-striped table-responsive mb-60">
                    <tbody>
                      <% @match.teams.first.team_players.includes(character: [ :player ], profession: [], secondary_profession: [], team_player_skills: [ :skill ], team_player_stats: []).order(position: :asc).each do |team_player| %>
                        <%= render 'team_player', team_player: team_player %>
                      <% end %>
                    </tbody>
                  </table>
                </div>
                <div class="cyberpress-match-participant">
                  <table class="table table-striped table-responsive mb-60">
                    <tbody>
                      <% @match.teams.second.team_players.order(position: :asc).each do |team_player| %>
                        <%= render 'team_player', team_player: team_player %>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
            <% if @match.map_name.present? %>
              <div class="d-flex align-items-center mb-4">
                <div class="flex-grow-1 text-center">
                  <h4 class="mb-2"><%= @match.map_name %></h4>
                  <% if @match.match_type.present? || @match.mat_round.present? %>
                    <p class="mb-0">
                    <% if @match.match_type.present? %>
                      <%= @match.match_type %>
                    <% end %>
                    <% if @match.match_type&.include?("MAT") && @match.mat_round.present? %>
                      - <%= @match.mat_round %>
                  <% end %>
                    </p>
                  <% end %>
                </div>
                <% if @match.map_id.present? && File.exist?(Rails.root.join("app/assets/images/guildhalls/#{@match.map_id}.jpg")) %>
                  <%= image_tag "guildhalls/#{@match.map_id}.jpg", alt: @match.map_name, class: 'img-fluid', style: 'max-width: 400px; border-radius: 8px;' %>
                <% end %>
              </div>
            <% end %>
            <% cache @match do %>
              <ul class="cyberpress-matchs-archive" data-sr="matches" data-sr-duration="1000">
                <li class="cyberpress-match" data-sr-item="matches">
                  <div class="cyberpress-match-participants">
                    <div class="cyberpress-match-participant col-lg-5">
                      <h2 class="cyberpress-match-participant-title h4">
                        <%= link_to match_path(@match) do %>
                          <% if @match.teams.first.rank.present? %>
                            <span class="guild-rank">#<%= @match.teams.first.rank %></span>
                          <% end %>
                          <%= @match.teams.first.guild.name_with_tag %>
                        <% end %>
                        <% if @match.winner_team == @match.teams.first %>
                          <span style="color: #ffc107; font-size: 1.2rem;">🏆</span>
                        <% end %>
                      </h2>
                      <ul class="cyberpress-match-info">
                        <li><%= link_to 'Guild details', guild_path(@match.teams.first.guild) %></li>
                      </ul>
                    </div>
                    <div class="cyberpress-match-participant-vs col-lg-2">
                      <%= link_to match_path(@match) do %>
                        <span><%= @match.round_text %></span>
                        <span class="cyberpress-match-participant-time-start"><%= @match.tournament.date %></span>
                        <span class="cyberpress-match-points h3">VS</span>
                      <% end %>
                    </div>
                    <div class="cyberpress-match-participant col-lg-5">
                      <h2 class="cyberpress-match-participant-title h4 text-right">
                        <% if @match.winner_team == @match.teams.second %>
                          <span style="color: #ffc107; font-size: 1.2rem;">🏆</span>
                        <% end %>
                        <%= link_to match_path(@match) do %>
                          <% if @match.teams.second.rank.present? %>
                            <span class="guild-rank">#<%= @match.teams.second.rank %></span>
                          <% end %>
                          <%= @match.teams.second.guild.name_with_tag %>
                        <% end %>
                      </h2>
                      <ul class="cyberpress-match-info">
                        <li><%= link_to 'Guild details', guild_path(@match.teams.second.guild) %></li>
                      </ul>
                    </div>
                  </div>
                </li>
              </ul>
            <% end %>

            <% if @match.movies.any? %>
              <% @match.movies.each do |movie| %>
                <% if movie.provider.eql?('youtube') %>
                  <iframe width="1140" max-width="100%" height="642" src="https://www.youtube-nocookie.com/embed/<%= movie.youtube_embed_id %>" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                <% end %>
              <% end %>
            <% else %>
              <h2 data-sr data-sr-duration="1200" data-sr-distance="10" class="mt-30">Post a YouTube record</h2>
            <% end %>
            <% if current_player && (current_player.is_moderator? || current_player.eql?(@match.imported_by)) %>
              <%= form_with model: @movie, url: movies_path, class: 'mb-0', data: { 'sr-duration': 1200, 'sr-distance': 10 } do |form| %>
                <%= form.hidden_field :movieable_type, value: 'Match' %>
                <%= form.hidden_field :movieable_id, value: @match.id %>
                <%= form.hidden_field :provider, value: 'youtube' %>
                <div class="row vgap">
                  <div class="col-6">
                    <%= form.url_field :video_url, placeholder: 'YouTube URL', class: 'form-control' %><span class="form-control-bg"></span>
                  </div>
                  <div class="col-6">
                    <%= form.submit 'Submit', class: 'btn btn-md btn-success' %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p>You need to be logged in to post a YouTube record.</p>
              <%= form_tag(omniauth_authorize_path(:player, :discord), method: 'post', data: { turbo: false }) do %>
                <button type="submit" class="btn btn-md btn-brand">Login with Discord</button>
              <% end %>
            <% end %>

            <% if @match.json.present? %>
              <h2 data-sr data-sr-duration="1200" data-sr-distance="10" class="mt-60 mb-30">Match Statistics</h2>

              <% cache @match, expires_in: 1.hour do %>
                <% health_data = @match.health_percentage_data %>
                <% guild_lord_data = @match.guild_lord_damage_data %>
                <% if health_data %>
                  <% has_health = health_data[:team1] && health_data[:team1][:data]&.any? %>
                  <% has_morale = health_data[:morale_data] && (health_data[:morale_data][:team1][:data]&.any? || health_data[:morale_data][:team2][:data]&.any?) %>
                  <% has_events = (health_data[:death_events]&.any? || health_data[:resurrection_events]&.any? || health_data[:morale_boosts]&.any? || health_data[:npc_death_events]&.any?) %>
                  <% has_guild_lords = guild_lord_data && guild_lord_data[:guild_lords]&.any? %>
                  <% initial_mode = has_health ? 'health' : (has_events ? 'timeline' : 'health') %>

                  <% if has_health || has_events %>
                    <div class="cyberpress-match mb-60">
                      <div class="cyberpress-match-participants">
                        <div class="cyberpress-match-participant" style="width: 100%;">
                          <div style="background: rgba(0, 0, 0, 0.3); padding: 30px; border-radius: 8px; min-height: 500px; width: 100%;" 
                               data-controller="health-chart" 
                               data-health-chart-data-value="<%= health_data.to_json %>"
                               data-health-chart-guild-lord-data-value="<%= (guild_lord_data || {}).to_json %>"
                               data-health-chart-initial-mode-value="<%= initial_mode %>"
                               data-health-chart-shrine-icon-value="<%= image_path('commons/shrine.jpg') %>"
                               data-health-chart-ressig-icon-value="<%= image_path('commons/ressig.jpg') %>"
                               data-health-chart-morale-icon-value="<%= image_path('commons/Morale_Boost.jpg') %>">
                               <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                 <p style="color: #ccc; margin: 0; font-size: 14px;">
                                 💡 Use mouse wheel to zoom • Click & drag to pan
                                 </p>
                                 <div style="display: flex; gap: 10px;">
                                   <button 
                                      data-action="click->health-chart#setModeHealth"
                                      data-health-chart-target="healthButton"
                                      class="btn btn-sm <%= initial_mode == 'health' ? 'btn-primary' : 'btn-outline-primary' %>"
                                      style="font-size: 12px; padding: 4px 12px;">
                                      Health
                                   </button>
                                   <button 
                                      data-action="click->health-chart#setModeMorale"
                                      data-health-chart-target="moraleButton"
                                      class="btn btn-sm <%= initial_mode == 'morale' ? 'btn-primary' : 'btn-outline-primary' %>"
                                      style="font-size: 12px; padding: 4px 12px;">
                                      Morale
                                   </button>
                                   <button 
                                      data-action="click->health-chart#setModeTimeline"
                                      data-health-chart-target="timelineButton"
                                      class="btn btn-sm <%= initial_mode == 'timeline' ? 'btn-primary' : 'btn-outline-primary' %>"
                                      style="font-size: 12px; padding: 4px 12px;">
                                      Timeline
                                   </button>
                                   <button 
                                      data-action="click->health-chart#setModeGuildLord"
                                      data-health-chart-target="guildLordButton"
                                      class="btn btn-sm btn-outline-primary"
                                      style="font-size: 12px; padding: 4px 12px;">
                                      Guild Lord Damage
                                   </button>
                                   <button 
                                      data-action="click->health-chart#resetZoom"
                                      class="btn btn-sm btn-outline-light"
                                      style="font-size: 12px; padding: 4px 12px;">
                                      Reset Zoom
                                   </button>
                                 </div>
                               </div>
                               <canvas style="max-height: 450px; height: 450px;"></canvas>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                <% end %>

                <div class="cyberpress-match">
                  <div class="cyberpress-match-participants">
                    <div class="cyberpress-match-participant">
                      <h3 class="mb-20">
                        <%= @match.teams.first.guild.name_with_tag %>
                        <% winning_party = @match.json.dig('winning_party_id') %>
                        <% if winning_party == 1 %>
                          <span style="color: #ffc107; font-size: 1.2rem;">🏆</span>
                        <% end %>
                      </h3>
                      <%= render 'team_stats', team: @match.teams.first, team_stats: @match.team_stats(1), team_index: 1, match: @match %>
                    </div>
                    <div class="cyberpress-match-participant">
                      <h3 class="mb-20 text-right">
                        <% if winning_party == 2 %>
                          <span style="color: #ffc107; font-size: 1.2rem;">🏆</span>
                        <% end %>
                        <%= @match.teams.second.guild.name_with_tag %>
                      </h3>
                      <%= render 'team_stats', team: @match.teams.second, team_stats: @match.team_stats(2), team_index: 2, match: @match %>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>

            <h2 data-sr data-sr-duration="1200" data-sr-distance="10" class="mt-30">Comments <small>(<%= @match.comments.count %>)</small></h2>
            <% if @match.comments.any? %>
              <ul class="list-unstyled list-vgap-md">
                <% @match.comments.each do |comment| %>
                  <li data-sr data-sr-duration="1200" data-sr-distance="10">
                    <div class="media mpl-media-comment">
                      <div class="media-head">
                        <span class="media-image"></span>
                        <div>
                          <%= link_to "#{comment.player.name} (#{comment.player.verification_status})", player_path(comment.player), class: 'media-title h5' %>
                          <div class="media-subtitle"><%= time_ago_in_words(comment.created_at) %></div>
                        </div>
                      </div>
                      <div class="media-body">
                        <p><%= comment.body %></p>
                      </div>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% end %>
            <h2 data-sr data-sr-duration="1200" data-sr-distance="10" class="mt-30">Leave a Comment</h2>
            <% if current_player %>
              <%= form_with model: @comment, url: comments_path, class: 'mb-0', data: { 'sr-duration': 1200, 'sr-distance': 10 } do |form| %>
                <%= form.hidden_field :commentable_type, value: 'Match' %>
                <%= form.hidden_field :commentable_id, value: @match.id %>
                <div class="row vgap">
                  <div class="col-12">
                    <%= form.text_area :body, rows: 5, placeholder: 'Your Comment', class: 'form-control' %>
                  </div>
                  <div class="col-12">
                    <%= form.submit 'Submit', class: 'btn btn-md btn-success' %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p>You need to be logged in to post comments.</p>
              <%= form_tag(omniauth_authorize_path(:player, :discord), method: 'post', data: { turbo: false }) do %>
                <button type="submit" class="btn btn-md btn-brand">Login with Discord</button>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <%= render 'footer' %>
  </div>
</div>
