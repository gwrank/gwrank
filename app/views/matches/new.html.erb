<div class="max-w-md mx-auto my-8">
  <div class="gw-window gw-frame">
    <div class="gw-window-header"><h1 class="gw-title text-base m-0">Add a Match</h1></div>
    <div class="p-5 space-y-4">
      <p class="text-muted text-sm">Export your matches from GWToolbox Observer Module and import them here.</p>
      <%= form_with model: @match do |form| %>
        <div class="space-y-3">
          <div>
            <%= form.label :json_file, 'JSON file from GWToolbox Observer Module :', class: "block text-sm text-parchment mb-1" %>
            <%= form.file_field :json_file, placeholder: 'JSON file, from Observer', class: 'gw-input', required: true %>
          </div>
          <div>
            <%= form.submit 'Import Match', class: 'gw-btn w-full' %>
          </div>
        </div>
      <% end %>
      <div class="text-sm text-muted pt-2 border-t border-hairline">
        <strong>How it works:</strong><br>
        1. Launch GWToolbox Observer Module<br>
        2. Export your match as JSON version 1.0<br>
        3. Upload the file here to add it to GWRank
      </div>
    </div>
  </div>
</div>
