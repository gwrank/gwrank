<div class="space-y-4">
  <div class="gw-window gw-frame">
    <%= render "application/gw_tabs", tabs: [["Matches", matches_path]] %>
    <div class="gw-window-header">
      <h1 class="gw-title text-base m-0">Matches</h1>
      <span class="gw-count text-sm"><%= @pagy.count %> matches</span>
      <%= link_to 'Add a Match', new_match_path, class: 'gw-btn ml-auto' %>
    </div>

    <% active_filters = params[:opponent].present? || params[:date_from].present? || params[:date_to].present? || params[:tournament_type].present? || params[:flux_month].present? || params[:map_id].present? %>
    <details class="border-b border-hairline" <%= 'open' if active_filters %>>
      <summary class="gw-window-header cursor-pointer select-none list-none">
        <span class="gw-title text-xs">Filters</span>
        <span class="text-muted text-xs"><%= active_filters ? "· active" : "· none" %></span>
      </summary>
      <div class="p-4">
        <%= render "filters" %>
      </div>
    </details>

    <% if @matches.any? %>
      <ul class="list-none m-0 p-0">
        <% cache @matches do %>
          <% @matches.each do |match| %>
            <%= render "match", match: match %>
          <% end %>
        <% end %>
      </ul>
    <% else %>
      <p class="gw-empty">No matches found for these filters.</p>
    <% end %>

    <div class="flex justify-center p-4">
      <div class="gw-pagy"><%== @pagy.series_nav(:bootstrap) %></div>
    </div>
  </div>
</div>
