<div class="content-wrap">
    <div class="mpl-navbar-mobile-overlay"></div>
    <div>
        <section class="mpl-banner mpl-banner-top mpl-banner-parallax mpl-banner-small">
            <div class="mpl-image" data-speed="0.8">
                <%= image_tag 'background.jpg', class: 'jarallax-img' %>
            </div>
            <div class="mpl-banner-content mpl-box-lg">
                <div class="container">
                    <h1 class="display-1 mb-0">Matches</h1>
                </div>
            </div>
        </section>
        <div class="mpl-box-md">
            <div class="container">
                <div class="row hgap-lg vgap-lg">
                    <div class="col-lg mpl-content">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/">Home</a></li>
                                <li class="breadcrumb-item active"><%= link_to 'Matches', matches_path %></li>
                            </ol>
                        </nav>
                        <ul class="cyberpress-matchs-archive" data-sr="matches" data-sr-duration="1000">
                            <% @matches.each do |match| %>
                                <li class="cyberpress-match cyberpress-match-compact" data-sr-item="matches" data-controller="match-builds" data-match-builds-match-id-value="<%= match.id %>">
                                    <%= link_to match_path(match) do %>
                                        <div class="cyberpress-match-header">
                                            <div class="cyberpress-match-meta">
                                                <span class="cyberpress-match-round"><%= match.round_text %></span>
                                                <% if match.tournament&.tournament_type.present? %>
                                                    <span class="cyberpress-match-tournament-type"><%= match.tournament.tournament_type.upcase %></span>
                                                <% end %>
                                                <span class="cyberpress-match-date"><%= match.played_at&.to_date %></span>
                                            </div>
                                        </div>
                                        <div class="cyberpress-match-participants">
                                            <div class="cyberpress-match-participant">
                                                <h3 class="cyberpress-match-participant-title">
                                                    <% if match.teams.first.rank.present? %>
                                                        <span class="guild-rank">#<%= match.teams.first.rank %></span>
                                                    <% end %>
                                                    <%= match.teams.first.guild.name_with_tag %>
                                                    <% if match.winner_team == match.teams.first %>
                                                      <span style="color: #ffc107; font-size: 1.2rem;">🏆</span>
                                                    <% end %>
                                                </h3>
                                                <div class="cyberpress-match-professions" data-action="mouseenter->match-builds#show mouseleave->match-builds#hide">
                                                    <% match.teams.first.team_players.order(:position).each do |team_player| %>
                                                        <%= team_player.profession.html_image.html_safe %>
                                                    <% end %>
                                                </div>
                                            </div>
                                            <div class="cyberpress-match-vs">
                                                <span>VS</span>
                                            </div>
                                            <div class="cyberpress-match-participant cyberpress-match-participant-right">
                                                <h3 class="cyberpress-match-participant-title">
                                                    <% if match.teams.second.rank.present? %>
                                                        <span class="guild-rank">#<%= match.teams.second.rank %></span>
                                                    <% end %>
                                                    <%= match.teams.second.guild.name_with_tag %>
                                                    <% if match.winner_team == match.teams.second %>
                                                      <span style="color: #ffc107; font-size: 1.2rem;">🏆</span>
                                                    <% end %>
                                                </h3>
                                                <div class="cyberpress-match-professions" data-action="mouseenter->match-builds#show mouseleave->match-builds#hide">
                                                    <% match.teams.second.team_players.order(:position).each do |team_player| %>
                                                        <%= team_player.profession.html_image.html_safe %>
                                                    <% end %>
                                                </div>
                                            </div>
                                        </div>
                                    <% end %>
                                    
                                    <!-- Builds popup -->
                                    <div class="match-builds-popup" data-match-builds-target="popup" style="display: none;">
                                        <div class="match-builds-popup-content">
                                            <div class="match-builds-teams">
                                                <% match.teams.each do |team| %>
                                                    <div class="match-builds-team">
                                                        <h4 class="match-builds-team-name"><%= team.guild.name_with_tag %></h4>
                                                        <div class="match-builds-players">
                                                            <% team.team_players.order(:position).each do |team_player| %>
                                                                <div class="match-builds-player">
                                                                    <div class="match-builds-player-header">
                                                                        <%= team_player.profession.html_image_simple.html_safe %>
                                                                        <%= team_player.secondary_profession.html_image_simple.html_safe %>
                                                                        <span class="match-builds-player-name"><%= team_player.igname %></span>
                                                                    </div>
                                                                    <div class="match-builds-player-skills">
                                                                        <%= team_player.html_skills_simple.html_safe %>
                                                                    </div>
                                                                </div>
                                                            <% end %>
                                                        </div>
                                                    </div>
                                                <% end %>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            <% end %>
                            <%== @pagy.series_nav(:bootstrap) %>
                        </ul>
                    </div>
                    <div class="col-auto-lg mpl-sidebar" data-sr="widget" data-sr-duration="1200" data-sr-distance="20">
                      <%= link_to 'Add a Match', new_match_path, class: 'btn btn-md' %>
                    </div>
                </div>
            </div>
        </div>
        <%= render 'footer' %>
    </div>
</div>
