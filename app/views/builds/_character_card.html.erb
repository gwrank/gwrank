<article class="gw-window gw-frame">
  <div class="gw-window-header">
    <span class="flex shrink-0 -space-x-1" aria-hidden="true">
      <span class="gw-prof-chip w-[26px] h-[26px]"><%= row[:summary].primary_profession&.html_image_simple(size: 26) %></span>
      <span class="gw-prof-chip w-[26px] h-[26px]"><%= row[:summary].secondary_profession&.html_image_simple(size: 26) %></span>
    </span>
    <strong class="min-w-0 text-gold-400 truncate"><%= row[:summary].name.presence || "(unnamed)" %></strong>
    <% if row[:summary].assignment.present? %><span class="gw-badge gw-badge--mode"><%= row[:summary].assignment %></span><% end %>
    <% if row[:summary].dominant_attribute.present? %><small class="ml-auto text-muted"><%= row[:summary].dominant_attribute %></small><% end %>
  </div>
  <div class="p-4">
    <div class="gw-skillbar mb-3">
      <% row[:skills].each_with_index do |skill, index| %>
        <% if skill %>
          <span class="gw-skillbar-slot <%= "gw-skillbar-slot--elite" if index == 7 %>" title="<%= skill.name %>"><%= skill.html_image_simple(size: 30) %></span>
        <% else %>
          <span class="gw-skillbar-slot gw-skillbar-slot--empty"></span>
        <% end %>
      <% end %>
    </div>
    <% if row[:attributes].any? %>
      <ul class="list-none grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1 text-sm text-[#cfcfcf] p-0 m-0 mb-2">
        <% row[:attributes].each do |attribute| %>
          <li class="flex justify-between"><span><%= attribute[:name] %></span> <strong class="text-gold-400"><%= attribute[:points] %></strong></li>
        <% end %>
      </ul>
    <% end %>
    <% if row[:notes].present? %>
      <p class="italic text-sm text-[#8a7565] m-0"><%= row[:notes] %></p>
    <% end %>
  </div>
</article>
