<div class="gw-window gw-frame mb-4">
  <%= render "application/gw_tabs", tabs: [["Build Library", builds_path], [truncate(@teambuild.name.presence || "(unnamed)", length: 28), nil]] %>
  <div class="gw-window-header">
    <h1 class="gw-title text-base m-0"><%= @teambuild.name.presence || "(unnamed)" %></h1>
    <%= render "badges", teambuild: @teambuild %>
    <small class="text-muted">by @<%= @teambuild.player&.username || "unknown" %></small>
    <%= link_to "Download .zcx", download_build_path(@teambuild), class: "gw-btn ml-auto" %>
  </div>

  <% if @compositions.many? %>
    <div data-controller="variant-tabs">
      <div class="gw-tabs mb-[-1px]" role="tablist">
        <% @compositions.each do |composition| %>
          <button type="button"
                  class="gw-tab cursor-pointer"
                  role="tab"
                  id="<%= composition[:id] %>-tab"
                  data-variant-tabs-target="tab"
                  data-composition-id="<%= composition[:id] %>"
                  aria-selected="false"
                  data-action="variant-tabs#select">
            <span class="mr-1.5 inline-block h-2 w-2 rounded-full align-middle" style="background-color: <%= composition[:color] %>"></span>Composition <%= composition[:index] %>
          </button>
        <% end %>
      </div>
      <% @compositions.each_with_index do |composition, i| %>
        <div data-variant-tabs-target="panel"
             role="tabpanel"
             aria-labelledby="<%= composition[:id] %>-tab"
             data-composition-id="<%= composition[:id] %>"
             class="<%= "hidden" unless i.zero? %>"
             aria-hidden="<%= i.zero? ? "false" : "true" %>">
          <%= render "build_table", rows: composition[:rows] %>
        </div>
      <% end %>
    </div>
  <% elsif @compositions.one? %>
    <%= render "build_table", rows: @compositions.first[:rows] %>
  <% else %>
    <p class="gw-empty">This build has no characters.</p>
  <% end %>
</div>
