<a class="gw-row" href="<%= build_path(teambuild) %>">
  <span class="flex shrink-0 -space-x-1.5" aria-hidden="true">
    <% teambuild.teambuild_characters.first(8).each do |character| %>
      <span class="rounded-full border border-gold-600 bg-[#241a09] overflow-hidden w-6 h-6 inline-flex"><%= character.primary_profession&.html_image_simple(size: 24) %></span>
    <% end %>
  </span>
  <span class="flex-1 min-w-0">
    <span class="block text-gold-400 font-semibold truncate"><%= teambuild.name.presence || "(unnamed)" %></span>
    <span class="flex flex-wrap gap-1 mt-1">
      <% if teambuild.status == "draft" %><span class="gw-badge gw-badge--draft">Draft</span><% end %>
      <% if teambuild.visibility != "public" %><span class="gw-badge gw-badge--private"><%= teambuild.visibility %></span><% end %>
      <span class="gw-badge gw-badge--mode"><%= teambuild.game_mode.presence || "?" %></span>
      <% teambuild.tags.each do |tag| %><span class="gw-badge gw-badge--tag"><%= tag %></span><% end %>
    </span>
  </span>
  <span class="text-[#9b8a5f] text-xs whitespace-nowrap shrink-0">by @<%= teambuild.player&.username || "unknown" %> · updated <%= teambuild.updated_at.strftime("%d/%m/%Y") %></span>
</a>
