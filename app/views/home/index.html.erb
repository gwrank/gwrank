<div class="content-wrap">
  <div class="mpl-navbar-mobile-overlay"></div>
  <div>
    <section class="mpl-banner mpl-banner-top mpl-banner-parallax">
      <div class="mpl-image" data-speed="0.8">
        <%= image_tag 'background.jpg', class: 'jarallax-img' %>
      </div>
      <div class="mpl-banner-content mpl-box-sm">
        <div class="container">
          <div class="row">
            <div class="col-lg-12 mb-6" data-sr="banner" data-sr-interval="200" data-sr-duration="1200" data-sr-distance="20">
              <h1 class="display-1" data-sr-item="banner">GWRank Reforged</h1>
              <p class="lead" data-sr-item="banner">
              Guild Wars GWR ranking system. Track your matches, climb the leaderboards, and showcase your skills.
              </p>
              <%= render "searches/form", search_query: '' %>
              <% if current_player %>
                <div class="mt-3">
                  <%= link_to 'Add a match from GWToolbox', new_match_path, class: 'btn btn-md btn-brand me-2' %>
                  <%= link_to 'Edit your profile', player_path(current_player), class: 'btn btn-md btn-outline-brand' %>
                </div>
                <p class="small mt-2" data-sr-item="banner">
                Logged in as: <strong><%= current_player.name %></strong> |
                <a href="<%= destroy_player_session_path %>" data-turbo-method="delete">Log Out</a>
                </p>
              <% else %>
                <div class="mt-3">
                  <%= link_to 'Login with Discord to Add Matches', new_player_session_path, class: 'btn btn-md btn-brand' %>
                </div>
                <p class="small mt-2" data-sr-item="banner">
                Open source on <a href="https://github.com/gwrank/gwrank" target="_blank" class="text-primary">GitHub</a>.
                Your privacy matters - we never see your Discord email or password.
                </p>
              <% end %>
            </div>
            <div class="col-lg-12 mb-6">
              <h2 class="h4 mb-20">Top 3 Players by GWR</h2>
              <% if @top_elo_players.any? %>
                <div class="table-responsive">
                  <table class="table table-striped table-hover mb-0">
                    <thead>
                      <tr>
                        <th style="width: 50px;">Rank</th>
                        <th>Player</th>
                        <th style="width: 120px;">GWR Rating</th>
                        <th style="width: 100px;">Matches</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @top_elo_players.each_with_index do |player, index| %>
                        <tr>
                          <td><strong>#<%= index + 1 %></strong></td>
                          <td><%= link_to display_player_name(player, current_player), player_path(player), class: 'text-link' %></td>
                          <td><span class="badge badge-success badge-lg"><%= player.elo_rating %></span></td>
                          <td><small><%= player.elo_matches || 0 %> matches</small></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
                <div class="text-center mt-20">
                  <%= link_to 'View all GWR statistics', statistics_path, class: 'btn btn-md btn-outline-brand' %>
                </div>
              <% else %>
                <div class="alert alert-warning">No GWR statistics available yet. Play matches to see your rank!</div>
              <% end %>
            </div>

            <div class="col-lg-12">
              <% if ENV['TWITCH_LIVE_CHANNEL'].present? %>
                <div class="col-lg-6" data-sr="banner" data-sr-interval="200" data-sr-duration="1200" data-sr-distance="20">
                  <h2>Twitch live</h2>
                  <div class="cyberpress-twitch">
                    <div class="cyberpress-twitch-player">
                      <iframe src="https://player.twitch.tv/?channel=<%= ENV['TWITCH_LIVE_CHANNEL'] %>&parent=<%= request.host %>" frameborder="0" allowfullscreen scrolling="no"></iframe>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
    </section>

    <div class="mpl-box-md">
      <div class="container">
        <div class="row hgap-lg vgap-lg">
          <div class="col-lg mpl-content">
            <div class="row vgap">
              <div class="col-12 col-md-6 col-lg-6">
                <div class="mpl-feature">
                  <div class="mpl-feature-title h4">
                    <%= pluralize Match.count, 'matches' %>
                  </div>
                  <div class="mpl-feature-text">
                    <%= link_to 'See last matches', matches_path, class: 'btn btn-md' %>
                  </div>
                </div>
              </div>
              <div class="col-12 col-md-6 col-lg-6">
                <div class="mpl-feature">
                  <div class="mpl-feature-title h4">
                    <%= pluralize Tournament.count, 'tournaments' %>
                  </div>
                  <div class="mpl-feature-text">
                    <%= link_to 'See last tournaments', tournaments_path, class: 'btn btn-md' %>
                  </div>
                </div>
              </div>
              <div class="col-12 col-md-6 col-lg-6">
                <div class="mpl-feature">
                  <div class="mpl-feature-title h4">
                    <%= pluralize Player.all.count, 'player' %>
                  </div>
                  <div class="mpl-feature-text">
                    <%= link_to 'See all players', players_path, class: 'btn btn-md' %>
                  </div>
                </div>
              </div>
              <div class="col-12 col-md-6 col-lg-6">
                <div class="mpl-feature">
                  <div class="mpl-feature-title h4">
                    <%= pluralize Guild.active.count, 'active guilds' %>
                  </div>
                  <div class="mpl-feature-text">
                    <%= link_to 'See all guilds', guilds_path, class: 'btn btn-md' %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <%= render 'footer' %>
      </div>
  </div>
