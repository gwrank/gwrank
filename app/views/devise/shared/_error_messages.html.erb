<% if resource.errors.any? %>
  <div class="rounded-md border border-[#6b2a2a] bg-[#24100d] p-3 text-sm text-[#d98a8a]" role="alert">
    <ul class="list-disc pl-4 m-0 space-y-1">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
