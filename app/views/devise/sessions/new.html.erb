<%= render "devise/shared/gw_card", title: "Sign in" do %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="space-y-3">
      <%= f.label :email, class: "block text-sm text-parchment" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "gw-input" %>
      <%= f.label :password, class: "block text-sm text-parchment" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "gw-input" %>
      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-2 text-sm text-parchment">
          <%= f.check_box :remember_me %> Remember me
        </label>
      <% end %>
    </div>
    <%= f.submit "Sign in", class: "gw-btn mt-4 w-full" %>
  <% end %>
  <%= render "devise/shared/links" %>
<% end %>
