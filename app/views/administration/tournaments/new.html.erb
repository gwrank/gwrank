<%= render "application/gw_card", title: "New Tournament" do %>
  <%= form_with model: @tournament, url: administration_tournaments_path do |form| %>
    <div class="space-y-3">
      <%= form.label :year, 'Year', class: 'block text-sm text-parchment' %>
      <%= form.text_field :year, class: 'gw-input' %>
      <%= form.label :month, 'Month', class: 'block text-sm text-parchment' %>
      <%= form.text_field :month, class: 'gw-input' %>
    </div>
    <%= form.submit 'Publish', class: 'gw-btn mt-4 w-full' %>
  <% end %>
<% end %>
