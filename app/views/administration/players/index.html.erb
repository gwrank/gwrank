<div class="space-y-4">
  <div class="gw-window gw-frame">
    <div class="gw-window-header">
      <h1 class="gw-title text-base m-0">Players administration</h1>
      <span class="gw-count text-sm"><%= pluralize @players.count, 'player' %></span>
    </div>

    <div class="overflow-x-auto">
      <table class="gw-table">
        <thead>
          <tr>
            <th scope="col">Username</th>
            <th scope="col">In-game name</th>
            <th scope="col">Professions</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @players.each do |player| %>
            <tr>
              <td><strong><%= link_to player.username, player_path(player), class: 'hover:text-gold-400' %></strong></td>
              <td>
                <%= display_player_name(player, current_player) %>
              </td>
              <td>
                <% player.professions.each do |profession| %>
                  <span class="gw-badge gw-badge--tag mr-1"><%= profession.capitalize %></span>
                <% end %>
                <% if player.professions.empty? %>
                  <span class="gw-badge gw-badge--draft">Without profession</span>
                <% end %>
              </td>
              <td>
                <div class="flex flex-wrap gap-2 whitespace-nowrap">
                  <% if player.is_verified? %>
                    <%= link_to 'Remove verified badge', administration_player_unchecks_path(player), data: { turbo_method: :post }, class: 'gw-btn gw-btn--ghost' %>
                  <% elsif player.igname.present? && current_player&.is_admin? %>
                    <%= link_to 'Add verified badge', administration_player_checks_path(player), data: { turbo_method: :post }, class: 'gw-btn gw-btn--ghost' %>
                  <% else %>
                    <span class="inline-block cursor-not-allowed" title="The player needs an in-game name to be verified">
                      <button type="button" class="gw-btn gw-btn--danger opacity-50" disabled>Add verified badge</button>
                    </span>
                  <% end %>
                  <%= link_to 'Send scrim invitation', administration_player_invitations_path(player), data: { turbo_method: :post }, class: 'gw-btn gw-btn--ghost' %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
