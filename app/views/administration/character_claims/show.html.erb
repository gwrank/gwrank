<div class="space-y-4">
  <div class="gw-window gw-frame">
    <div class="gw-window-header">
      <h1 class="gw-title text-base m-0">Character Claim Details</h1>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-[1fr_360px] gap-4 p-4">
      <div id="character-claim" class="min-w-0 space-y-4">
        <% if @claim.approved? %>
          <p class="rounded border border-gold-600/40 p-3 m-0">
            <span class="gw-badge gw-badge--mode mr-2">APPROVED</span>
            This claim has been approved.
          </p>
        <% elsif @claim.rejected? %>
          <p class="rounded border border-gold-600/40 p-3 m-0">
            <span class="gw-badge gw-badge--private mr-2">REJECTED</span>
            This claim has been rejected.
          </p>
        <% else %>
          <p class="rounded border border-gold-600/40 p-3 m-0">
            <span class="gw-badge gw-badge--draft mr-2">PENDING</span>
            This claim is pending review.
          </p>
        <% end %>

        <h2 class="font-display text-gold-300 text-base m-0">
          <%= @claim.claimed_igname %>
          <% if @claim.pending? %>
            <span class="gw-badge gw-badge--draft ml-2">PENDING</span>
          <% elsif @claim.approved? %>
            <span class="gw-badge gw-badge--mode ml-2">APPROVED</span>
          <% else %>
            <span class="gw-badge gw-badge--private ml-2">REJECTED</span>
          <% end %>
        </h2>

        <ul class="list-none m-0 p-0 space-y-1 text-sm">
          <li>
            <strong>Character Profession:</strong> <%= @claim.character.profession&.name || 'Unknown' %>
          </li>
          <li>
            <strong>Claimed by:</strong>
            <%= link_to @claim.player.username, edit_profile_path(@claim.player), class: 'hover:text-gold-400' %>
          </li>
          <li>
            <strong>Email:</strong> <%= @claim.player.email %>
          </li>
          <li>
            <strong>Submitted on:</strong> <%= @claim.created_at.strftime('%B %d, %Y at %I:%M %p') %>
          </li>
          <li>
            <strong>Status:</strong>
            <span class="gw-badge <%= @claim.approved? ? 'gw-badge--mode' : (@claim.rejected? ? 'gw-badge--private' : 'gw-badge--draft') %>">
              <%= @claim.status.humanize %>
            </span>
          </li>
        </ul>

        <div class="flex flex-wrap gap-2 whitespace-nowrap">
          <% if @claim.pending? %>
            <%= link_to 'Approve Claim', approve_administration_character_claim_path(@claim), data: { turbo_method: :post }, class: 'gw-btn' %>
            <%= link_to 'Reject Claim', reject_administration_character_claim_path(@claim), data: { turbo_method: :post, turbo_confirm: 'Are you sure you want to reject this claim?' }, class: 'gw-btn gw-btn--danger' %>
          <% else %>
            <%= link_to 'Back to Claims List', administration_character_claims_path, class: 'gw-btn gw-btn--ghost' %>
          <% end %>
        </div>
      </div>

      <aside class="space-y-3">
        <iframe src="https://discord.com/widget?id=788820055029973045&theme=dark" width="100%" height="600" allowtransparency="true" frameborder="0" sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"></iframe>
        <%= link_to 'https://discord.gg/jqshPZBkcj', target: '_blank', rel: 'noopener noreferrer', class: 'gw-btn' do %>
          Join us on Discord
        <% end %>
      </aside>
    </div>
  </div>
</div>
