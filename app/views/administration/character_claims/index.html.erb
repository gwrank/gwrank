<div class="space-y-4">
  <div class="gw-window gw-frame">
    <div class="gw-window-header">
      <h1 class="gw-title text-base m-0">Character Claims</h1>
      <span class="gw-count text-sm"><%= pluralize @claims.count, 'pending claim' %></span>
    </div>

    <% if @claims.empty? %>
      <p class="gw-empty">No pending character claims.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="gw-table">
          <thead>
            <tr>
              <th>In-game name</th>
              <th>Status</th>
              <th>Profession</th>
              <th>Claimed by</th>
              <th>Submitted</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @claims.each do |claim| %>
              <tr>
                <td><strong><%= link_to claim.claimed_igname, administration_character_claim_path(claim), class: 'hover:text-gold-400' %></strong></td>
                <td>
                  <% if claim.pending? %>
                    <span class="gw-badge gw-badge--draft">PENDING</span>
                  <% elsif claim.approved? %>
                    <span class="gw-badge gw-badge--mode">APPROVED</span>
                  <% else %>
                    <span class="gw-badge gw-badge--private">REJECTED</span>
                  <% end %>
                </td>
                <td><%= claim.character.profession&.name || 'Unknown' %></td>
                <td><%= link_to claim.player.username, edit_profile_path(claim.player), class: 'hover:text-gold-400' %></td>
                <td class="text-muted"><%= claim.created_at.strftime('%B %d, %Y at %I:%M %p') %></td>
                <td>
                  <% if claim.pending? %>
                    <div class="flex flex-wrap gap-2 whitespace-nowrap">
                      <%= link_to 'Approve Claim', approve_administration_character_claim_path(claim), data: { turbo_method: :post }, class: 'gw-btn gw-btn--ghost' %>
                      <%= link_to 'Reject Claim', reject_administration_character_claim_path(claim), data: { turbo_method: :post, turbo_confirm: 'Are you sure you want to reject this claim?' }, class: 'gw-btn gw-btn--ghost' %>
                    </div>
                  <% else %>
                    <%= link_to 'Back to Claims List', administration_character_claims_path, class: 'gw-btn gw-btn--ghost' %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
