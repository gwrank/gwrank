<div class="space-y-4">
  <div class="gw-window gw-frame">
    <%= render "application/gw_tabs", tabs: [["Players", players_path], [display_player_name(@player, current_player), nil]] %>
    <div class="gw-window-header">
      <span class="gw-prof-chip w-9 h-9 shrink-0 items-center justify-center font-display text-gold-300 text-base bg-ink-700" aria-hidden="true"><%= display_player_name(@player, current_player).first.upcase %></span>
      <h1 class="font-display text-gold-300 text-lg m-0 tracking-wide"><%= display_player_name(@player, current_player) %></h1>
      <% if @player.is_verified? %>
        <span class="gw-badge gw-badge--mode">Verified</span>
      <% end %>
      <% if @player.eql?(current_player) %>
        <%= link_to 'Edit profile', edit_profile_path, class: 'gw-btn ml-auto' %>
      <% end %>
    </div>

    <div class="p-4 space-y-6">
      <% cache @player do %>
        <ul class="list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-1 text-sm">
          <li>GWR Rating: <strong class="text-gold-300"><%= @player.elo_rating %></strong></li>
          <li>GWR Matches: <strong class="text-gold-300"><%= @player.elo_matches %></strong></li>
          <% if @player.guild_id.present? %>
            <li><%= link_to "Guild: #{@player.guild.name_with_tag}", guild_path(@player.guild), class: "hover:text-gold-400" %></li>
          <% end %>
          <% @player.characters.each do |character| %>
            <li>Character: <%= display_character_name(character, current_player) %></li>
          <% end %>
          <% if @player.is_warrior? %>
            <li>Average crits / minute: <strong class="text-gold-300"><%= @player.average_warrior_cpm&.round(2) || 'N/A' %></strong></li>
          <% end %>
          <li>Average DPM: <strong class="text-gold-300"><%= @player.average_dpm&.round(2) || 'N/A' %></strong></li>
          <li>Avg Dmg/Game: <strong class="text-gold-300"><%= @player.average_dmg_per_game&.round(0) || 'N/A' %></strong></li>
          <li>Avg Deaths/Game: <strong class="text-gold-300"><%= @player.average_deaths_per_game&.round(2) || 'N/A' %></strong></li>
          <li>K/D Ratio: <strong class="text-gold-300"><%= @player.kd_ratio&.round(2) || 'N/A' %></strong></li>
          <li>Avg Team ELO: <strong class="text-gold-300"><%= @player.average_team_elo || 'N/A' %></strong></li>
          <li>Avg Opponent ELO: <strong class="text-gold-300"><%= @player.average_opponent_elo || 'N/A' %></strong></li>
          <% @player.professions.each do |profession| %>
            <li><span class="gw-badge gw-badge--tag mr-1"><%= profession.capitalize %></span></li>
          <% end %>
          <% if @player.twitch_username.present? %>
            <li><a href="https://www.twitch.com/<%= @player.twitch_username %>" target="_blank" rel="noopener noreferrer" class="text-gold-400 hover:text-gold-500">Twitch</a></li>
          <% end %>
        </ul>
      <% end %>

      <% if @player.twitch_username.present? %>
        <section>
          <h2 class="font-display text-gold-300 text-base mb-2">Twitch</h2>
          <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-3">
            <iframe src="https://player.twitch.tv/?channel=<%= @player.twitch_username %>&parent=<%= request.host %>" frameborder="0" allowfullscreen scrolling="no" class="w-full aspect-video"></iframe>
            <iframe src="https://www.twitch.tv/embed/<%= @player.twitch_username %>/chat?parent=<%= request.host %>" frameborder="0" scrolling="no" class="w-full min-h-[400px]"></iframe>
          </div>
        </section>
      <% end %>

      <% if @guilds.any? %>
        <section>
          <h2 class="font-display text-gold-300 text-base mb-2">Played with</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <% @guilds.each do |guild| %>
              <%= render "guilds/guild", guild: guild %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @matches.any? %>
        <%= render "matches", teams: @matches, pagy: @matches_pagy %>
      <% end %>
    </div>
  </div>
</div>
