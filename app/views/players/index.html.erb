<div class="space-y-4">
  <div class="gw-window gw-frame">
    <%= render "application/gw_tabs", tabs: [["Players", players_path]] %>
    <div class="gw-window-header">
      <h1 class="gw-title text-base m-0">Players</h1>
      <span class="gw-count text-sm"><%= @pagy.count %> ranked</span>
    </div>
    <div class="p-4 border-b border-[#2b2010]">
      <%= render "searches/form", search_query: '' %>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-[1fr_360px] gap-4 p-4">
      <div id="players" class="min-w-0">
        <% if @players.any? %>
          <table class="gw-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Player</th>
                <th>GWR</th>
                <th>Guild</th>
              </tr>
            </thead>
            <tbody>
              <% @players.each_with_index do |player, index| %>
                <% cache player do %>
                  <tr>
                    <td class="text-muted"><%= index + 1 %></td>
                    <td>
                      <strong><%= link_to display_player_name(player, current_player), player_path(player), class: "hover:text-gold-400" %></strong>
                      <% if player.is_verified? %>
                        <span class="gw-badge gw-badge--mode ml-1">Verified</span>
                      <% end %>
                    </td>
                    <td class="font-display text-gold-300"><%= player.elo_rating %></td>
                    <td>
                      <% if player.guild_id.present? %>
                        <%= link_to player.guild.name_with_tag, guild_path(player.guild), class: "hover:text-gold-400" %>
                      <% else %>
                        <span class="text-muted">—</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="gw-empty">No ranked players found.</p>
        <% end %>
        <div class="flex justify-center pt-4">
          <div class="gw-pagy"><%== @pagy.series_nav(:bootstrap) %></div>
        </div>
      </div>

      <aside class="space-y-3">
        <iframe src="https://discord.com/widget?id=788820055029973045&theme=dark" width="100%" height="600" allowtransparency="true" frameborder="0" sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"></iframe>
        <%= link_to 'https://discord.gg/jqShPZBkcj', target: '_blank', rel: 'noopener noreferrer', class: 'gw-btn' do %>
          Join us on Discord
        <% end %>
      </aside>
    </div>
  </div>
</div>
