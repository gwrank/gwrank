<div class="space-y-4">
  <div class="gw-window gw-frame">
    <%= render "application/gw_tabs", tabs: [["Scrims", scrims_path]] %>
    <div class="gw-window-header">
      <h1 class="gw-title text-base m-0">Scrims</h1>
      <span class="text-muted text-sm"><%= Date.today %></span>
      <% if @active_scrim %>
        <span class="gw-badge gw-badge--mode ml-auto">Live</span>
      <% end %>
    </div>

    <div class="p-4 space-y-6">
      <%= render "searches/form", search_query: '' %>

      <section class="flex flex-wrap items-center gap-3">
        <span class="font-display text-gold-300"><%= pluralize @current_registrations.count, 'current registration' %></span>
        <span class="ml-auto"></span>
        <% if current_player %>
          <% if current_player.has_current_registration? %>
            <%= form_with model: current_player.current_registration, method: :delete do |form| %>
              <%= form.submit 'Unregister myself', class: 'gw-btn gw-btn--danger' %>
            <% end %>
          <% else %>
            <%= form_with model: Registration do |form| %>
              <%= form.submit 'Register myself', class: 'gw-btn' %>
            <% end %>
          <% end %>
        <% else %>
          <%= form_tag(omniauth_authorize_path(:player, :discord), method: 'post', data: { turbo: false }) do %>
            <button type="submit" class="gw-btn">Login with Discord to register myself</button>
          <% end %>
        <% end %>
      </section>

      <% if @current_registrations.any? %>
        <section>
          <h2 class="font-display text-gold-300 text-base mb-2">Current registrations</h2>
          <div class="overflow-x-auto">
            <table class="gw-table">
              <thead>
                <tr>
                  <th>Position</th>
                  <th>Username</th>
                  <th>In-game name</th>
                  <th>Professions</th>
                </tr>
              </thead>
              <tbody>
                <% @current_registrations.each_with_index do |current_registration, index| %>
                  <tr>
                    <td><strong><%= index + 1 %></strong></td>
                    <td><%= link_to current_registration.player.username, player_path(current_registration.player), class: "hover:text-gold-400" %></td>
                    <td><%= display_player_name(current_registration.player, current_player) %></td>
                    <td>
                      <% current_registration.player.professions.each do |profession| %>
                        <span class="gw-badge gw-badge--tag mr-1"><%= profession.capitalize %></span>
                      <% end %>
                      <% if current_registration.player.professions.empty? %>
                        <span class="gw-badge gw-badge--draft">Without profession</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% else %>
        <p class="gw-empty">No current registrations.</p>
      <% end %>

      <% if @active_scrim %>
        <section class="rounded border border-gold-600/40 p-4 space-y-3">
          <div class="flex flex-wrap items-center gap-3">
            <h2 class="font-display text-gold-300 text-base m-0">Active scrim</h2>
            <span class="font-display text-gold-300 text-2xl tracking-wider"><%= @active_scrim.team_a_wins %>-<%= @active_scrim.team_b_wins %></span>
            <%= link_to 'View scrim details', scrim_path(@active_scrim), class: 'gw-btn gw-btn--ghost' %>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <h3 class="font-display text-parchment text-sm mb-1">Team A</h3>
              <ul class="list-none m-0 p-0 text-sm space-y-1">
                <% @active_scrim.team_a.team_players.includes(:player, :profession).each do |team_player| %>
                  <li>
                    <%= link_to team_player.player.name, player_path(team_player.player), class: "hover:text-gold-400" %>
                    (<%= team_player.profession.name %>)<%= ' - captain' if team_player.is_captain? %>
                  </li>
                <% end %>
              </ul>
            </div>
            <div>
              <h3 class="font-display text-parchment text-sm mb-1">Team B</h3>
              <ul class="list-none m-0 p-0 text-sm space-y-1">
                <% @active_scrim.team_b.team_players.includes(:player, :profession).each do |team_player| %>
                  <li>
                    <%= link_to team_player.player.name, player_path(team_player.player), class: "hover:text-gold-400" %>
                    (<%= team_player.profession.name %>)<%= ' - captain' if team_player.is_captain? %>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</div>
