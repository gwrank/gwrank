<div class="space-y-4">
  <div class="gw-window gw-frame">
    <%= render "application/gw_tabs", tabs: [["Guilds", guilds_path]] %>
    <div class="gw-window-header">
      <h1 class="gw-title text-base m-0">Guilds</h1>
      <span class="gw-count text-sm"><%= @pagy.count %> guilds</span>
      <% if current_player %>
        <% if current_player.guild.present? %>
          <%= link_to 'Go to my Guild', guild_path(current_player.guild), class: 'gw-btn ml-auto' %>
        <% else %>
          <%= link_to 'Register my Guild', new_guild_path, class: 'gw-btn ml-auto' %>
        <% end %>
      <% else %>
        <%= form_tag(omniauth_authorize_path(:player, :discord), method: 'post', data: { turbo: false }, class: 'ml-auto') do %>
          <button type="submit" class="gw-btn">Login with Discord to register my guild</button>
        <% end %>
      <% end %>
    </div>

    <div class="p-4 space-y-4">
      <%= render "searches/form", search_query: '' %>

      <% if @guilds.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <% @guilds.each do |guild| %>
            <% cache guild do %>
              <%= render "guild", guild: guild %>
            <% end %>
          <% end %>
        </div>
        <div class="flex justify-center">
          <div class="gw-pagy"><%== @pagy.series_nav(:bootstrap) %></div>
        </div>
      <% else %>
        <p class="gw-empty">No guilds found.</p>
      <% end %>
    </div>
  </div>
</div>
