<div class="col-span-1">
  <div class="gw-parchment border border-gold-600/40 rounded-md p-4 hover:border-gold-500 transition-colors">
    <h2 class="font-display text-base m-0">
      <%= link_to guild.name_with_tag, guild_path(guild), class: "hover:text-gold-500" %>
    </h2>
    <ul class="list-none m-0 mt-2 p-0 text-sm space-y-1">
      <li><%= pluralize guild.players.count, 'player' %></li>
      <li>Average GWR: <strong class="text-gold-600"><%= guild.average_elo %></strong></li>
    </ul>
  </div>
</div>
