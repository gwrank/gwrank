<div class="max-w-md mx-auto my-8">
  <div class="gw-window gw-frame">
    <div class="gw-window-header"><h1 class="gw-title text-base m-0">New Guild</h1></div>
    <div class="p-5 space-y-4">
      <%= form_with model: @guild do |form| %>
        <div class="space-y-3">
          <div>
            <%= form.text_field :name, placeholder: 'Name', class: 'gw-input', required: true %>
          </div>
          <div>
            <%= form.text_field :tag, placeholder: 'Tag, without [ ]', class: 'gw-input', required: true %>
          </div>
          <div>
            <%= form.submit 'Create', class: 'gw-btn w-full' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
