<div class="space-y-4">
  <div class="gw-window gw-frame">
    <%= render "application/gw_tabs", tabs: [["Guilds", guilds_path], [@guild.name_with_tag, nil]] %>
    <div class="gw-window-header">
      <h1 class="font-display text-gold-300 text-lg m-0 tracking-wide"><%= @guild.name_with_tag %></h1>
      <span class="gw-count text-sm"><%= pluralize @guild.players.count, 'player' %> · avg GWR <%= @guild.average_elo %></span>
    </div>

    <div class="p-4 space-y-6">
      <% cache @guild do %>
        <ul class="list-none m-0 p-0 flex flex-wrap gap-x-6 gap-y-1 text-sm">
          <li><span class="text-muted">Guild:</span> <%= @guild.name_with_tag %></li>
          <li><%= pluralize @guild.players.count, 'player' %></li>
        </ul>
      <% end %>

      <% if @guild.players.any? %>
        <section>
          <h2 class="font-display text-gold-300 text-base mb-2">Players</h2>
          <div class="overflow-x-auto">
            <table class="gw-table">
              <thead>
                <tr>
                  <th>Username</th>
                  <th>In-game names</th>
                  <th>Professions</th>
                </tr>
              </thead>
              <tbody>
                <% @guild.players.each do |player| %>
                  <tr>
                    <td><%= link_to player.username, player_path(player), class: "hover:text-gold-400" %></td>
                    <td>
                      <% player.characters.each do |character| %>
                        <%= display_character_name(character, current_player) %><br>
                      <% end %>
                    </td>
                    <td>
                      <% player.professions.each do |profession| %>
                        <span class="gw-badge gw-badge--tag mr-1"><%= profession.capitalize %></span>
                      <% end %>
                      <% if player.professions.empty? %>
                        <span class="gw-badge gw-badge--draft">Without profession</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <% if @guild.tournament_results.any? %>
        <section>
          <h2 class="font-display text-gold-300 text-base mb-2">Tournament results</h2>
          <div class="overflow-x-auto">
            <table class="gw-table">
              <thead>
                <tr>
                  <th>Tournament</th>
                  <th>Position</th>
                  <th>Trim</th>
                </tr>
              </thead>
              <tbody>
                <% @guild.tournament_results.includes(:tournament).final_standings.order(:position).each do |tournament_result| %>
                  <tr>
                    <td>
                      <%= link_to tournament_result.tournament.title, tournament_path(tournament_result.tournament), class: "hover:text-gold-400" %>
                    </td>
                    <td><%= tournament_result.position %></td>
                    <td><%= tournament_result.trim_text %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <% if @guild.teams.any? %>
        <section>
          <h2 class="font-display text-gold-300 text-base mb-2">Matches</h2>
          <div class="overflow-x-auto">
            <table class="gw-table">
              <thead>
                <tr>
                  <th>Tournament</th>
                  <th>Match</th>
                </tr>
              </thead>
              <tbody>
                <% @guild.teams.each do |team| %>
                  <tr>
                    <td><%= link_to team.match.tournament.title, tournament_path(team.match.tournament), class: "hover:text-gold-400" %></td>
                    <td><%= link_to team.match.title, match_path(team.match), class: "hover:text-gold-400" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</div>
