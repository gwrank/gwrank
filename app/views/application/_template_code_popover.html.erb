<%# locals: (template_code:, name:, primary_profession: nil, secondary_profession: nil, assignment: nil) %>
<% if template_code.present? %>
  <span class="relative inline-flex align-middle" data-controller="template-code-popover">
    <button type="button"
            class="gw-imgs-inline cursor-pointer text-muted hover:text-gold-400"
            data-template-code-popover-target="trigger"
            data-action="template-code-popover#toggle"
            aria-label="Show template code"
            aria-expanded="false">
      <svg width="25px" class="icon" viewBox="0 0 24 24" stroke="currentColor" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M5 17H4C3.46957 17 2.96086 16.7893 2.58579 16.4142C2.21071 16.0391 2 15.5304 2 15V5C2 4.46957 2.21071 3.96086 2.58579 3.58579C2.96086 3.21071 3.46957 3 4 3H20C20.5304 3 21.0391 3.21071 21.4142 3.58579C21.7893 3.96086 22 4.46957 22 5V15C22 15.5304 21.7893 16.0391 21.4142 16.4142C21.0391 16.7893 20.5304 17 20 17H19M12 15L17 21H7L12 15Z"></path>
      </svg>
    </button>
    <span class="hidden absolute right-0 top-7 z-50 w-72 rounded border border-gold-600 bg-[rgba(16,11,5,.97)] p-3 shadow-lg"
          data-template-code-popover-target="card">
      <span class="mb-2 flex items-center gap-2">
        <span class="gw-prof-chip h-[22px] w-[22px]"><%= primary_profession&.html_image_simple(size: 22) %></span>
        <span class="gw-prof-chip h-[22px] w-[22px]"><%= secondary_profession&.html_image_simple(size: 22) %></span>
        <strong class="truncate text-sm text-gold-400"><%= name %></strong>
        <% if assignment.present? %><span class="gw-badge gw-badge--mode"><%= assignment %></span><% end %>
      </span>
      <code class="block break-all rounded border border-hairline bg-black px-2 py-1.5 text-xs text-gold-400"
            data-template-code-popover-target="code"><%= template_code %></code>
      <button type="button"
              class="gw-btn gw-btn--sm mt-2 w-full"
              data-action="template-code-popover#copy">Copy code</button>
    </span>
  </span>
<% end %>
