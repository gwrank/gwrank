<header class="gw-topbar sticky top-0 z-40">
  <div class="flex items-center gap-4 px-4 py-2.5 bg-gradient-to-b from-[#3a2c14]/85 to-[#171006]/95 border-b-2 border-gold-600 shadow-[0_2px_12px_rgba(0,0,0,.6)]">
    <%= link_to root_path, class: "font-display text-gold-300 font-bold tracking-widest leading-tight hover:text-gold-400" do %>
      ⚔ GWRANK
      <small class="block font-body font-normal tracking-wide text-[#9b8a5f] text-[10px] uppercase">Guild Wars · Hall of Heroes</small>
    <% end %>
    <nav class="ml-auto hidden md:flex items-center gap-1 text-[15px]" aria-label="Main">
      <%- main_nav_items.each do |item| %>
        <% active = gw_nav_active?(item[:path]) %>
        <%= link_to item[:label], item[:path],
              class: "gw-tab #{'gw-tab--active' if active}" %>
      <%- end %>
      <button type="button" data-action="search-dialog#open"
              class="ml-2 text-parchment/80 hover:text-gold-400" aria-label="Search">🔍</button>
    </nav>
    <div class="ml-auto md:ml-0 flex items-center gap-2">
      <% if current_player %>
        <span class="gw-badge gw-badge--tag"><%= current_player.name %></span>
        <%= link_to "Profile", player_path(current_player), class: "hidden sm:inline text-sm text-parchment/80 hover:text-gold-400" %>
        <%= link_to "Log out", destroy_player_session_path, data: { turbo_method: :delete }, class: "hidden sm:inline text-sm text-parchment/60 hover:text-gold-400" %>
      <% else %>
        <%= button_to "Login with Discord", omniauth_authorize_path(:player, :discord), data: { turbo: false }, class: "gw-btn gw-btn--ghost" %>
      <% end %>
    </div>
  </div>
  <div class="gw-divider"></div>
</header>
