<dialog data-search-dialog-target="dialog"
        class="backdrop:bg-black/70 bg-transparent m-auto p-0 w-[min(92vw,34rem)]">
  <form action="<%= search_path %>" method="get" role="search"
        class="gw-window gw-frame p-4 flex gap-2"
        data-action="search-dialog#submit">
    <input type="search" name="q" class="gw-input" placeholder="Type to Search…"
           data-search-dialog-target="input" autocomplete="off">
    <button type="submit" class="gw-btn">Go</button>
  </form>
</dialog>
