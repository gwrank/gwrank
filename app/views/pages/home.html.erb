  <div class="hero-content text-neutral-content text-center">
    <div class="max-w-md">
      <h1 class="mb-5 text-5xl font-bold">GWRank Reforged?</h1>
      <p class="mb-5">
      <%= pluralize Player.all.count, 'archived players' %>,
      <%= pluralize Guild.archived.count, 'archived guilds' %> and
      <%= pluralize Tournament.count, 'archived tournaments' %>...
      </p>
      <a href="https://discord.gg/Gjefv7GJ9g" class="btn btn-primary">Join Discord</a>
    </div>
  </div>
