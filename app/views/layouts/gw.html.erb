<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>GWRank.com</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="gw-body flex flex-col">
    <%= render "application/gw_topbar" %>
    <%= render "application/gw_flash" %>
    <main class="flex-1 w-full max-w-6xl mx-auto px-4 py-5">
      <%= yield %>
    </main>
    <%= render "application/gw_footer" %>
    <%= render "application/gw_search_dialog" %>
  </body>
</html>
