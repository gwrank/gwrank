<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>GWRank · Administration</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="gw-body flex flex-col">
    <header class="flex items-center gap-3 px-4 py-2.5 bg-gradient-to-b from-[#3a2c14] to-[#171006] border-b-2 border-gold-600">
      <strong class="font-display text-gold-300 tracking-widest">⚔ GWRANK <span class="text-[#9b8a5f] font-normal">· Admin</span></strong>
      <nav class="ml-auto flex gap-1 text-sm" aria-label="Administration">
        <%= link_to "Players", administration_players_path, class: "gw-tab #{request.path.start_with?('/administration/players') ? 'text-gold-400 border-gold-600' : ''}" %>
        <%= link_to "Claims", administration_character_claims_path, class: "gw-tab #{request.path.start_with?('/administration/character_claims') ? 'text-gold-400 border-gold-600' : ''}" %>
        <%= link_to "← Site", root_path, class: "gw-tab" %>
      </nav>
    </header>
    <%= render "application/gw_flash" %>
    <main class="flex-1 w-full max-w-6xl mx-auto px-4 py-5">
      <%= yield %>
    </main>
  </body>
</html>
