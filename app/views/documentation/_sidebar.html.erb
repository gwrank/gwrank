        <li><%= link_to 'AT Commands', at_doc_path, class: "block border-l-2 pl-3 py-1 #{current_page?(at_doc_path) ? 'border-gold-500 text-gold-400' : 'border-hairline text-muted hover:text-parchment'}" %></li>
