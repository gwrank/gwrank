<div class="content-wrap">
  <div class="mpl-navbar-mobile-overlay"></div>
  <div>
    <section class="mpl-banner mpl-banner-top mpl-banner-parallax mpl-banner-small">
      <div class="mpl-image" data-speed="0.8">
        <%= image_tag 'background.jpg', class: 'jarallax-img' %>
      </div>
      <div class="mpl-banner-content mpl-box-sm">
        <div class="container">
          <div class="row">
            <div class="col-lg-10">
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                  <li class="breadcrumb-item"><a href="/">Home</a></li>
                  <li class="breadcrumb-item active">Statistics</li>
                </ol>
              </nav>
              <h1 class="lg:display-1 mb-0"><span class="badge badge-brand">Beta</span> Statistics</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <div class="container mpl-box-md">
      <%= render "searches/form", search_query: '' %>

      <div class="alert alert-brand" role="alert">
        <strong>How ELO Works</strong>
        <p class="mb-2">
        The ELO rating system is a method for calculating the relative skill levels of players.
        After each match, players gain or lose points based on the outcome and the skill level of their opponents.
        </p>

        <h5 class="mt-3">The ELO Formula</h5>
        <div class="mt-2 p-3 rounded" style="font-family: monospace; font-size: 0.9em;">
          <p class="mb-2"><strong>New ELO = Old ELO + K × (Actual Score - Expected Score)</strong></p>

          <div class="mb-2">
            <strong>Expected Score:</strong><br>
            <code>E<sub>A</sub> = 1 / (1 + 10<sup>(R<sub>B</sub> - R<sub>A</sub>) / 400</sup>)</code><br>
            <small>Probability of Player A winning against Player B</small>
          </div>

          <div>
            <strong>Variables:</strong>
            <ul class="mb-0 ml-3">
              <li><strong>R<sub>A</sub></strong> = Rating of Player A before the match</li>
              <li><strong>R<sub>B</sub></strong> = Rating of Player B before the match</li>
              <li><strong>E<sub>A</sub></strong> = Expected score for Player A (0 to 1)</li>
              <li><strong>K</strong> = K-factor (typically 32, 20, or 40)</li>
              <li><strong>Actual Score</strong> = 1 (win), 0.5 (draw), or 0 (loss)</li>
            </ul>
          </div>
        </div>

        <div class="mt-3">
          <strong>Key Points:</strong>
          <ul class="mb-0 ml-3">
            <li>Winning against higher-rated players yields more points</li>
            <li>Losing to lower-rated players results in more point loss</li>
            <li>Matches between evenly matched players result in smaller ELO changes</li>
            <li>Player ELO is the <strong>maximum ELO</strong> achieved across all characters</li>
            <li>Guild ELO is the <strong>average</strong> of all guild members' ELO ratings</li>
          </ul>
        </div>
        <p class="mb-0 mt-3">
        <em>Soon: Players need at least 5 matches to qualify for rankings.</em>
        </p>
      </div>

      <h2>ELO Rankings - Top 10 Players</h2>
      <div class="alert alert-brand mb-30" role="alert">
        <strong>New Feature!</strong> Our ELO-based ranking system is now live. This system tracks player performance
        across all matches and updates ratings after each game. Players need at least 5 matches to qualify.
        <a href="https://discord.gg/Gjefv7GJ9g" target="_blank" class="btn btn-brand btn-sm float-end">Join Discord</a>
      </div>
      <% if @top_elo_players.any? %>
        <div class="table-responsive">
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th style="width: 50px;">Rank</th>
                <th>Player</th>
                <th>ELO Rating</th>
                <th style="width: 100px;">Matches</th>
              </tr>
            </thead>
            <tbody>
              <% @top_elo_players.each_with_index do |player, index| %>
                <tr>
                  <td><strong>#<%= index + 1 %></strong></td>
                  <td><%= link_to player.igname, player_path(player), class: 'text-link' %></td>
                  <td><span class="badge badge-success badge-lg"><%= player.elo_rating %></span></td>
                  <td><small><%= player.elo_matches || 0 %> matches</small></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-warning">No player statistics available yet. Play matches to see your rank!</div>
      <% end %>

      <!-- ELO by Profession Section -->
      <section class="mb-50">
        <h2 class="h4 mb-20">ELO by Profession</h2>
        <% if @elo_by_profession.any? %>
          <div class="row vgap-20">
            <% @elo_by_profession.sort_by { |_, stats| stats[:avg_elo] }.reverse.each do |profession, stats| %>
              <div class="col-md-6 col-sm-12">
                <div class="mpl-counter-box h-100">
                  <div class="d-flex justify-content-between align-items-center mb-15">
                    <h3 class="h5 mb-0 text-primary"><%= profession %></h3>
                    <span class="badge badge-primary badge-lg"><%= stats[:avg_elo].round %></span>
                  </div>
                  <div class="progress mb-10" style="height: 10px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: <%= [stats[:avg_elo].to_f / 2000.0 * 100, 100].min %>%;" aria-valuenow="<%= stats[:avg_elo] %>" aria-valuemin="0" aria-valuemax="2000"></div>
                  </div>
                  <div class="d-flex justify-content-between small">
                    <span><%= stats[:player_count] %> players</span>
                    <span>Avg ELO</span>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="alert alert-warning">No profession statistics available yet.</div>
        <% end %>
      </section>

      <h2 class="mb-20">Top 10 Players by ELO for Each Profession</h2>
      <% if @top_players_by_profession.any? %>
        <% @top_players_by_profession.each do |profession_name, players| %>
          <% if players.any? %>
            <div class="mb-40">
              <h3 class="h5 mb-20 text-primary"><%= profession_name %></h3>
              <div class="table-responsive">
                <table class="table table-striped table-sm">
                  <thead>
                    <tr>
                      <th style="width: 50px;">Rank</th>
                      <th>Player</th>
                      <th style="width: 120px;">ELO Rating</th>
                      <th style="width: 100px;">Matches</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% players.each_with_index do |player, index| %>
                      <tr>
                        <td><strong>#<%= index + 1 %></strong></td>
                        <td><%= link_to player.igname, player_path(player), class: 'text-link' %></td>
                        <td><span class="badge badge-success badge-lg"><%= player.elo_rating %></span></td>
                        <td><small><%= player.elo_matches || 0 %> matches</small></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <div class="alert alert-warning">No profession statistics available yet.</div>
      <% end %>
    </div>
    <%= render 'footer' %>
  </div>
</div>
