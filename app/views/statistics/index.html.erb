<div class="content-wrap">
  <div class="mpl-navbar-mobile-overlay"></div>
  <div>
    <section class="mpl-banner mpl-banner-top mpl-banner-parallax mpl-banner-small">
      <div class="mpl-image" data-speed="0.8">
        <%= image_tag 'background.jpg', class: 'jarallax-img' %>
      </div>
      <div class="mpl-banner-content mpl-box-sm">
        <div class="container">
          <div class="row">
            <div class="col-lg-10">
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                  <li class="breadcrumb-item"><a href="/">Home</a></li>
                  <li class="breadcrumb-item active">Ranks</li>
                </ol>
              </nav>
              <h1 class="lg:display-1 mb-0"><span class="badge badge-brand">Beta</span> Ranks</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <div class="container mpl-box-md">
      <%= render "searches/form", search_query: '' %>

      <h2>GWR Top 10 Players</h2>
      <div class="alert alert-brand mb-30" role="alert">
        <strong>New Feature!</strong> Our GWR-based ranking system is now live. This system tracks player performance
        across matches and updates ratings after each game.
        <a href="https://discord.gg/Gjefv7GJ9g" target="_blank" class="btn btn-brand btn-sm float-end">Join Discord</a>
      </div>
      <% if @top_elo_players.any? %>
        <div class="table-responsive">
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th style="width: 50px;">Rank</th>
                <th>Player</th>
                <th>GWR Rating</th>
                <th style="width: 100px;">Matches</th>
              </tr>
            </thead>
            <tbody>
              <% @top_elo_players.each_with_index do |player, index| %>
                <tr>
                  <td><strong>#<%= index + 1 %></strong></td>
                  <td><%= link_to player.igname, player_path(player), class: 'text-link' %></td>
                  <td><span class="badge badge-primary badge-lg"><%= player.elo_rating %></span></td>
                  <td><small><%= player.elo_matches || 0 %> matches</small></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-warning">No player statistics available yet. Play matches to see your rank!</div>
      <% end %>

      <h2>GWR Top 10 Guilds</h2>
      <% if @top_guilds_by_elo.any? %>
        <div class="table-responsive">
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th style="width: 50px;">Rank</th>
                <th>Guild</th>
                <th style="width: 120px;">Avg GWR</th>
                <th style="width: 100px;">Players</th>
              </tr>
            </thead>
            <tbody>
              <% @top_guilds_by_elo.each_with_index do |guild, index| %>
                <tr>
                  <td><strong>#<%= index + 1 %></strong></td>
                  <td><%= link_to guild.name_with_tag, guild_path(guild), class: 'text-link' %></td>
                  <td><span class="badge badge-primary"><%= guild.avg_elo.round %></span></td>
                  <td><small><%= guild.players.count %> players</small></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-warning">No guild statistics available yet.</div>
      <% end %>

      <h2>GWR Top 10 Players by Profession</h2>
      <!-- Profession Navigation -->
      <div data-controller="profession-nav">
        <!-- Navigation Buttons -->
        <div class="mb-30" data-profession-nav-target="navButtons">
          <div class="d-flex flex-wrap gap-2 justify-content-start" role="tablist">
            <button type="button"
                    class="btn btn-outline-primary"
                    data-action="click->profession-nav#selectProfession"
                    data-profession="all">
                    All Professions
            </button>
            <% if @top_players_by_profession.any? %>
              <% @top_players_by_profession.each_with_index do |(profession_name, players), index| %>
                <% if players.any? %>
                  <button type="button"
                          class="btn btn-outline-primary"
                          data-action="click->profession-nav#selectProfession"
                          data-profession="<%= profession_name %>">
                          <%= profession_name %>
                  </button>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Profession Sections -->
        <div data-profession-nav-target="professionSections">
          <% if @top_players_by_profession.any? %>
            <% @top_players_by_profession.each_with_index do |(profession_name, players), index| %>
              <% if players.any? %>
                <div class="mb-40"
                     id="<%= profession_name.downcase %>"
                     data-profession="<%= profession_name %>"
                     data-action="scroll->profession-nav#scrollToSection"
                     data-profession-nav-target="professionSection">
                     <h3 class="h5 mb-20 text-primary">
                       <a href="#top" class="float-end text-muted" aria-label="Back to top">#</a>
                       <%= profession_name %>
                     </h3>
                     <div class="table-responsive">
                       <table class="table table-striped table-sm">
                         <thead>
                           <tr>
                             <th style="width: 50px;">Rank</th>
                             <th>Player</th>
                             <th style="width: 120px;">GWR Rating</th>
                             <th style="width: 100px;">Matches</th>
                           </tr>
                         </thead>
                         <tbody>
                           <% players.each_with_index do |player, index| %>
                             <tr>
                               <td><strong>#<%= index + 1 %></strong></td>
                               <td><%= link_to player.igname, player_path(player), class: 'text-link' %></td>
                               <td><span class="badge badge-primary badge-lg"><%= player.elo_rating %></span></td>
                               <td><small><%= player.elo_matches || 0 %> matches</small></td>
                             </tr>
                           <% end %>
                         </tbody>
                       </table>
                     </div>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <div class="alert alert-warning">No profession statistics available yet.</div>
          <% end %>
        </div>
      </div>
      <!-- How GWR Works Section -->
      <section class="mb-50">
        <h2 class="h4 mb-20"><strong>How GWR Works?</strong></h2>
        <div>
          <div class="row vgap-20">
            <div class="col-lg-8">
              <p class="mb-15">
              The GWR rating system is a method for calculating the relative skill levels of players.
              After each match, players gain or lose points based on the outcome and the skill level of their opponents.
              </p>

              <div class="alert alert-brand mb-15">
                <strong class="small">Important: Complete Match Data</strong><br>
                <p class="mb-0 small">
                GWR ratings are calculated from <strong>all KNOWN matches</strong> - both observed and non-observed on Top GvG Tournament Battles.
                Guilds that do not import all their match history from GWToolbox Observer Module will have
                <strong>inaccurate GWR ratings</strong>.
                </p>
              </div>

              <h5 class="mb-15">The GWR Formula</h5>
              <div class="p-3 rounded mb-15" style="font-family: monospace; font-size: 0.9em; overflow-x: auto;">
                <p class="mb-10 fw-bold">New GWR = Old GWR + K × (Actual Score - Expected Score)</p>

                <div class="mb-10">
                  <strong>Expected Score:</strong><br>
                  <code style="display: block; margin: 10px 0; padding: 10px; border-radius: 4px;">
                    E<sub>A</sub> = 1 / (1 + 10<sup>(R<sub>B</sub> - R<sub>A</sub>) / 400</sup>)
                  </code>
                  <small>Probability of Player A winning against Player B</small>
                </div>

                <div>
                  <strong>Variables:</strong>
                  <ul class="mb-0 ms-3">
                    <li><strong>R<sub>A</sub></strong> = Rating of Player A before the match</li>
                    <li><strong>R<sub>B</sub></strong> = Rating of Player B before the match</li>
                    <li><strong>E<sub>A</sub></strong> = Expected score for Player A (0 to 1)</li>
                    <li><strong>K</strong> = K-factor (typically 32, 20, or 40)</li>
                    <li><strong>Actual Score</strong> = 1 (win), 0.5 (draw), or 0 (loss)</li>
                  </ul>
                </div>
              </div>

              <h5 class="mb-10">Example Calculation</h5>
              <div class="p-3 rounded">
                <p class="mb-10 small">
                Player A (GWR 1200) vs Player B (GWR 1500):
                </p>
                <ol class="ms-3 mb-0 small">
                  <li class="mb-2">Expected score for A: E<sub>A</sub> = 1 / (1 + 10<sup>(1500-1200)/400</sup>) = <strong>0.24</strong></li>
                  <li class="mb-2">Expected score for B: E<sub>B</sub> = 1 / (1 + 10<sup>(1200-1500)/400</sup>) = <strong>0.76</strong></li>
                  <li class="mb-2">If Player A wins (Actual = 1, K=32):<br>
                    <span class="text-success">New GWR = 1200 + 32 × (1 - 0.24) = <strong>1224 (+24)</strong></span></li>
                  <li>If Player B wins (Actual = 0, K=32):<br>
                    <span class="text-danger">New GWR = 1500 + 32 × (0 - 0.76) = <strong>1475 (-25)</strong></span></li>
                </ol>
              </div>
            </div>
            <div class="col-lg-4">
              <h5 class="mb-15">Important Notes</h5>
              <div class="alert alert-brand mb-15">
                <strong class="small">Observer Limitation</strong><br>
                <p class="mb-0 small">
                Only matches with opponents in the <strong>Top 100</strong> are observed.
                Guilds missing from rankings must use <strong>GWToolbox Observer Module</strong> to import their matches.
                </p>
              </div>
              <div class="alert alert-warning mb-15">
                <strong class="small">Ranking Requirement</strong><br>
                <p class="mb-0 small">Players need at least 5 matches to appear in rankings.</p>
              </div>
              <div class="p-3 rounded">
                <h6 class="mb-10">Key Points</h6>
                <ul class="mb-0 small">
                  <li class="mb-3"><strong class="text-success">Upset Wins</strong><br>
                    <small>Winning against higher-rated players yields more points</small></li>
                  <li class="mb-3"><strong class="text-danger">Expected Losses</strong><br>
                    <small>Losing to lower-rated players results in more point loss</small></li>
                  <li class="mb-3"><strong class="text-primary">Fair Matches</strong><br>
                    <small>Matches between evenly matched players result in smaller GWR changes</small></li>
                  <li class="mb-3"><strong class="text-success">Peak GWR</strong><br>
                    <small>Player GWR is the <strong>maximum</strong> achieved across all characters</small></li>
                  <li><strong class="text-primary">Guild GWR</strong><br>
                    <small>Is the <strong>average</strong> of all guild members' GWR ratings</small></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

    </div>
    <%= render 'footer' %>
  </div>
</div>
