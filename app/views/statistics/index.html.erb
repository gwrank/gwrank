<div class="space-y-4">
  <div class="gw-window gw-frame">
    <%= render "application/gw_tabs", tabs: [["Ranks", statistics_path]] %>
    <div class="gw-window-header">
      <h1 class="gw-title text-base m-0">Ranks</h1>
      <span class="gw-badge gw-badge--mode">Beta</span>
    </div>

    <div class="p-4 space-y-6">
      <%= render "searches/form", search_query: '' %>

      <div class="rounded border border-gold-600/40 p-4">
        <p class="m-0 text-sm">
          <strong><span class="gw-badge gw-badge--mode mr-2">Beta</span> Under Development</strong>
        </p>
        <p class="mt-2 mb-0 text-sm text-muted">
          This GWR-based ranking system is currently in beta. We are working to automatically import all Top GvG Tournament Battles.
          Currently, only matches with opponents in the Top 100 being observed are included in calculations.
          <br>
          <a href="https://discord.gg/jqShPZBkcj" target="_blank" rel="noopener noreferrer" class="text-gold-400 underline">Join Discord</a> to track progress or use GWToolbox Observer Module to import complete match history.
        </p>
      </div>

      <section>
        <h2 class="font-display text-gold-300 text-base mb-2">GWR Top 10 Players</h2>
        <% if @top_elo_players.any? %>
          <div class="overflow-x-auto">
            <table class="gw-table">
              <thead>
                <tr>
                  <th class="w-[50px]">Rank</th>
                  <th>Player</th>
                  <th>GWR Rating</th>
                  <th class="w-[100px]">Matches</th>
                </tr>
              </thead>
              <tbody>
                <% @top_elo_players.each_with_index do |player, index| %>
                  <tr>
                    <td><strong>#<%= index + 1 %></strong></td>
                    <td><%= link_to display_player_name(player, current_player), player_path(player), class: 'hover:text-gold-400' %></td>
                    <td><span class="gw-badge gw-badge--mode"><%= player.elo_rating %></span></td>
                    <td><small class="text-muted"><%= player.elo_matches || 0 %> matches</small></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="gw-empty">No player statistics available yet. Play matches to see your rank!</p>
        <% end %>
      </section>

      <section>
        <h2 class="font-display text-gold-300 text-base mb-2">GWR Top 10 Guilds</h2>
        <% if @top_guilds_by_elo.any? %>
          <div class="overflow-x-auto">
            <table class="gw-table">
              <thead>
                <tr>
                  <th class="w-[50px]">Rank</th>
                  <th>Guild</th>
                  <th class="w-[120px]">Avg GWR</th>
                  <th class="w-[100px]">Players</th>
                </tr>
              </thead>
              <tbody>
                <% @top_guilds_by_elo.each_with_index do |guild, index| %>
                  <tr>
                    <td><strong>#<%= index + 1 %></strong></td>
                    <td><%= link_to guild.name_with_tag, guild_path(guild), class: 'hover:text-gold-400' %></td>
                    <td><span class="gw-badge gw-badge--mode"><%= guild.avg_elo.round %></span></td>
                    <td><small class="text-muted"><%= guild.players.count %> players</small></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="gw-empty">No guild statistics available yet.</p>
        <% end %>
      </section>

      <section>
        <h2 class="font-display text-gold-300 text-base mb-2">GWR Top 10 Players by Profession</h2>
        <!-- Profession Navigation -->
        <div data-controller="profession-nav">
          <!-- Navigation Buttons -->
          <div class="mb-4" data-profession-nav-target="navButtons">
            <div class="flex flex-wrap gap-2 justify-start" role="tablist">
              <button type="button"
                      class="gw-btn gw-btn--ghost"
                      data-action="click->profession-nav#selectProfession"
                      data-profession="all">
                      All Professions
              </button>
              <% if @top_players_by_profession.any? %>
                <% @top_players_by_profession.each_with_index do |(profession_name, players), index| %>
                  <% if players.any? %>
                    <button type="button"
                            class="gw-btn gw-btn--ghost"
                            data-action="click->profession-nav#selectProfession"
                            data-profession="<%= profession_name %>">
                            <%= profession_name %>
                    </button>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>

          <!-- Profession Sections -->
          <div data-profession-nav-target="professionSections">
            <% if @top_players_by_profession.any? %>
              <% @top_players_by_profession.each_with_index do |(profession_name, players), index| %>
                <% if players.any? %>
                  <div class="mb-6"
                       id="<%= profession_name.downcase %>"
                       data-profession="<%= profession_name %>"
                       data-action="scroll->profession-nav#scrollToSection"
                       data-profession-nav-target="professionSection">
                       <h3 class="font-display text-gold-300 text-sm mb-2 flex items-center justify-between">
                         <span><%= profession_name %></span>
                         <a href="#top" class="text-muted hover:text-parchment" aria-label="Back to top">#</a>
                       </h3>
                       <div class="overflow-x-auto">
                         <table class="gw-table">
                           <thead>
                             <tr>
                               <th class="w-[50px]">Rank</th>
                               <th>Player</th>
                               <th class="w-[120px]">GWR Rating</th>
                               <th class="w-[100px]">Matches</th>
                             </tr>
                           </thead>
                           <tbody>
                             <% players.each_with_index do |player, index| %>
                               <tr>
                                 <td><strong>#<%= index + 1 %></strong></td>
                                 <td><%= link_to display_player_name(player, current_player), player_path(player), class: 'hover:text-gold-400' %></td>
                                 <td><span class="gw-badge gw-badge--mode"><%= player.elo_rating %></span></td>
                                 <td><small class="text-muted"><%= player.elo_matches || 0 %> matches</small></td>
                               </tr>
                             <% end %>
                           </tbody>
                         </table>
                       </div>
                  </div>
                <% end %>
              <% end %>
            <% else %>
              <p class="gw-empty">No profession statistics available yet.</p>
            <% end %>
          </div>
        </div>
      </section>

      <!-- How GWR Works Section -->
      <section class="gw-doc">
        <h2 class="font-display text-gold-300 text-xl tracking-wide">How GWR Works?</h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mt-3">
          <div class="lg:col-span-2 space-y-3">
            <p class="m-0">
            The GWR rating system is a method for calculating the relative skill levels of players.
            After each match, players gain or lose points based on the outcome and the skill level of their opponents.
            </p>

            <div class="rounded border border-gold-600/40 p-3">
              <strong class="block text-sm">Important: Complete Match Data</strong>
              <p class="m-0 mt-1 text-sm text-muted">
              GWR ratings are calculated from <strong>all KNOWN matches</strong> - both observed and non-observed on Top GvG Tournament Battles.
              Guilds that do not import all their match history from GWToolbox Observer Module will have
              <strong>inaccurate GWR ratings</strong>.
              </p>
            </div>

            <h3>The GWR Formula</h3>
            <div class="bg-ink-deep border border-gold-600/50 rounded p-3 text-sm space-y-2">
              <p class="m-0 font-bold">New GWR = Old GWR + K × (Actual Score - Expected Score)</p>

              <div>
                <strong>Expected Score:</strong><br>
                <code class="block my-2 p-2 rounded bg-black/40 text-gold-400">
                  E<sub>A</sub> = 1 / (1 + 10<sup>(R<sub>B</sub> - R<sub>A</sub>) / 400</sup>)
                </code>
                <small class="text-muted">Probability of Player A winning against Player B</small>
              </div>

              <div>
                <strong>Variables:</strong>
                <ul class="m-0 ml-4">
                  <li><strong>R<sub>A</sub></strong> = Rating of Player A before the match</li>
                  <li><strong>R<sub>B</sub></strong> = Rating of Player B before the match</li>
                  <li><strong>E<sub>A</sub></strong> = Expected score for Player A (0 to 1)</li>
                  <li><strong>K</strong> = K-factor (typically 32, 20, or 40)</li>
                  <li><strong>Actual Score</strong> = 1 (win), 0.5 (draw), or 0 (loss)</li>
                </ul>
              </div>
            </div>

            <h3>Example Calculation</h3>
            <div class="bg-ink-deep border border-gold-600/50 rounded p-3 text-sm">
              <p class="m-0">
              Player A (GWR 1200) vs Player B (GWR 1500):
              </p>
              <ol class="ml-4 m-0 mt-2 space-y-1">
                <li>Expected score for A: E<sub>A</sub> = 1 / (1 + 10<sup>(1500-1200)/400</sup>) = <strong>0.24</strong></li>
                <li>Expected score for B: E<sub>B</sub> = 1 / (1 + 10<sup>(1200-1500)/400</sup>) = <strong>0.76</strong></li>
                <li>If Player A wins (Actual = 1, K=32):<br>
                  <span class="text-green-400">New GWR = 1200 + 32 × (1 - 0.24) = <strong>1224 (+24)</strong></span></li>
                <li>If Player B wins (Actual = 0, K=32):<br>
                  <span class="text-red-400">New GWR = 1500 + 32 × (0 - 0.76) = <strong>1475 (-25)</strong></span></li>
              </ol>
            </div>
          </div>
          <div class="space-y-3">
            <h3>Important Notes</h3>
            <div class="rounded border border-gold-600/40 p-3">
              <strong class="block text-sm">Observer Limitation</strong>
              <p class="m-0 mt-1 text-sm text-muted">
              Only matches with opponents in the <strong>Top 100</strong> are observed.
              Guilds missing from rankings must use <strong>GWToolbox Observer Module</strong> to import their matches.
              </p>
            </div>
            <div class="rounded border border-gold-600/40 p-3">
              <strong class="block text-sm">Ranking Requirement</strong>
              <p class="m-0 mt-1 text-sm text-muted">Players need at least 5 matches to appear in rankings.</p>
            </div>
            <div class="rounded border border-gold-600/40 p-3">
              <h3 class="m-0">Key Points</h3>
              <ul class="m-0 mt-2 p-0 list-none text-sm space-y-2">
                <li><strong class="text-green-400">Upset Wins</strong><br>
                  <small class="text-muted">Winning against higher-rated players yields more points</small></li>
                <li><strong class="text-red-400">Expected Losses</strong><br>
                  <small class="text-muted">Losing to lower-rated players results in more point loss</small></li>
                <li><strong class="text-gold-400">Fair Matches</strong><br>
                  <small class="text-muted">Matches between evenly matched players result in smaller GWR changes</small></li>
                <li><strong class="text-green-400">Peak GWR</strong><br>
                  <small class="text-muted">Player GWR is the <strong>maximum</strong> achieved across all characters</small></li>
                <li><strong class="text-gold-400">Guild GWR</strong><br>
                  <small class="text-muted">Is the <strong>average</strong> of all guild members' GWR ratings</small></li>
              </ul>
            </div>
          </div>
        </div>
      </section>

    </div>
  </div>
</div>
