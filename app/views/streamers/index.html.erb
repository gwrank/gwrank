<div class="space-y-4">
  <div class="gw-window gw-frame">
    <%= render "application/gw_tabs", tabs: [["Streamers", streamers_path]] %>
    <div class="gw-window-header">
      <h1 class="gw-title text-base m-0">Streamers</h1>
      <span class="gw-count text-sm"><%= @streamers.size %> streamers</span>
    </div>

    <div class="p-4 space-y-6">
      <section class="flex flex-wrap items-center gap-3">
        <% if current_player %>
          <% if current_player.twitch_username.present? %>
            <%= link_to 'Edit my Twitch', edit_profile_path, class: 'gw-btn' %>
          <% else %>
            <%= link_to 'Add my Twitch', edit_profile_path, class: 'gw-btn' %>
          <% end %>
        <% else %>
          <%= form_tag(omniauth_authorize_path(:player, :discord), method: 'post', data: { turbo: false }) do %>
            <button type="submit" class="gw-btn">Login with Discord to add my Twitch</button>
          <% end %>
        <% end %>
      </section>

      <% if @streamers.any? %>
        <div id="players" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
          <% @streamers.each do |player| %>
            <div class="gw-parchment rounded-md border border-gold-600/40 p-4 hover:border-gold-500 transition-colors">
              <h2 class="font-display text-base m-0">
                <%= link_to player.username, player_path(player), class: "hover:text-gold-500" %>
              </h2>
              <ul class="list-none m-0 mt-2 p-0 text-sm space-y-1">
                <% if player.guild_id.present? %>
                  <li class="flex items-center gap-2">
                    <svg class="icon w-4 h-4 shrink-0" viewBox="0 0 24 24" stroke="currentColor" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M17 21V19C17 17.9391 16.5786 16.9217 15.8284 16.1716C15.0783 15.4214 14.0609 15 13 15H5C3.93913 15 2.92172 15.4214 2.17157 16.1716C1.42143 16.9217 1 17.9391 1 19V21M23 21V19C22.9993 18.1137 22.7044 17.2528 22.1614 16.5523C21.6184 15.8519 20.8581 15.3516 20 15.13M16 3.13C16.8604 3.3503 17.623 3.8507 18.1676 4.55231C18.7122 5.25392 19.0078 6.11683 19.0078 7.005C19.0078 7.89317 18.7122 8.75608 18.1676 9.45769C17.623 10.1593 16.8604 10.6597 16 10.88M13 7C13 9.20914 11.2091 11 9 11C6.79086 11 5 9.20914 5 7C5 4.79086 6.79086 3 9 3C11.2091 3 13 4.79086 13 7Z" />
                    </svg>
                    <%= link_to player.guild.name_with_tag, guild_path(player.guild), class: "hover:text-gold-400" %>
                  </li>
                <% end %>
                <% player.characters.each do |character| %>
                  <li class="flex items-center gap-2">
                    <svg class="icon w-4 h-4 shrink-0" viewBox="0 0 24 24" stroke="currentColor" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21M16 7C16 9.20914 14.2091 11 12 11C9.79086 11 8 9.20914 8 7C8 4.79086 9.79086 3 12 3C14.2091 3 16 4.79086 16 7Z" />
                    </svg>
                    <%= display_character_name(character, current_player) %>
                  </li>
                <% end %>
                <% if player.is_verified? %>
                  <li class="flex items-center gap-2 pt-1">
                    <span class="gw-badge gw-badge--mode">Verified</span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="gw-empty">No streamers yet.</p>
      <% end %>
    </div>
  </div>
</div>
